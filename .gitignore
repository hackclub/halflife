# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but a public repo needs the template committed. The README documents
# eight required vars; without this a contributor has no list of their names.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# signup capture (local dev store)
# Real signups land here when SIGNUP_WEBHOOK_URL is unset — email addresses,
# so this must stay ignored whatever else changes.
/data

# local agent + editor config
# .claude/settings.local.json was only ever ignored by one machine's global
# gitignore, which does nothing for anyone else who clones this.
.claude/settings.local.json
.claude/settings.local.json.*
.claude/*.local.json
.vscode/
.idea/
*.swp
*.swo
*~

# os cruft
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store?
._*
.Spotlight-V100
.Trashes

# credentials beyond .env — nothing here today, and nothing should arrive
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
*.jks
*.keystore

# tool caches
.turbo/
.swc/
.eslintcache
.cache/
*.log

# one lockfile, and it is pnpm's. These are guards, not preferences: npm or
# yarn run in this repo will silently produce a second lockfile that resolves
# differently from pnpm-lock.yaml.
package-lock.json
yarn.lock
.pnpm-store/
# generated prisma client — output path is set in prisma/schema.prisma
/src/app/generated

# Local preview config. Machine-specific (it hardcodes a username and a
# throwaway auth secret for looking at the UI without the OIDC round trip),
# and a secret-shaped string in the repo is a bad habit even when it is fake.
/.claude/launch.json
