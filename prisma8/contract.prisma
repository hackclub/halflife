// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model ShopRegion {
    id                   String                @id(map: "shop_region_pkey")
    name                 String
    active               Boolean               @default(true)
    sortOrder            Int                   @default(0)
    createdAt            TimestampString(3)    @default(now())
    updatedAt            TimestampString(3)
    shopItemRegionPrices ShopItemRegionPrice[]
    users                User[]

    @@index([active, sortOrder], map: "shop_region_active_sortOrder_idx")
    @@map("shop_region")
  }

  model User {
    id                          String                       @id(map: "user_pkey")
    email                       String
    name                        String?
    emailVerified               Boolean                      @default(false)
    image                       String?
    createdAt                   TimestampString(3)           @default(now())
    updatedAt                   TimestampString(3)
    slackId                     String?
    slackDisplayName            String?
    hackatimeUserId             String?
    verificationStatus          String?
    bio                         String?
    pronouns                    String?
    timezone                    String?
    encryptedAddressStreet      String?
    encryptedAddressLine2       String?
    encryptedAddressCity        String?
    encryptedAddressState       String?
    encryptedAddressZip         String?
    encryptedAddressCountry     String?
    encryptedBirthday           String?
    encryptedPhone              String?
    joinedProgramAt             TimestampString(3)?
    submissionExtensionUntil    TimestampString(3)?
    fraudFlagged                Boolean                      @default(false)
    utmSource                   String?
    signupPage                  String?
    currentStreak               Int                          @default(0)
    lastStreakDate              String?
    longestStreak               Int                          @default(0)
    hardwareExperience          pg.enum(HardwareExperience)?
    onboardingCompletedAt       TimestampString(3)?
    onboardingStep              Int                          @default(0)
    trackingTutorialDismissedAt TimestampString(3)?
    printerGoalId               String?
    activeDays                  Int                          @default(0)
    firstProjectAt              TimestampString(3)?
    firstReelAt                 TimestampString(3)?
    firstSubmissionAt           TimestampString(3)?
    lastActiveAt                TimestampString(3)?
    lastLoginAt                 TimestampString(3)?
    lastSubmissionAt            TimestampString(3)?
    participantGoal             pg.enum(ParticipantGoal)?
    firstChecksPassedAt         TimestampString(3)?
    displayName                 String?
    shopRegionId                String?
    accounts                    Account[]
    hcbGrantTopups              HcbGrantTopup[]
    ledgerEntries               LedgerEntry[]
    posts                       Post[]
    postComments                PostComment[]
    postLikes                   PostLike[]
    postViews                   PostView[]
    printerAward                PrinterAward?
    publicReels                 PublicReel[]
    reviewClaims                ReviewClaim[]
    reviewDisputes              ReviewDispute[]
    reviewDisputeMessages       ReviewDisputeMessage[]
    sessions                    Session[]
    shopOrders                  ShopOrder[]
    shopOrderNotes              ShopOrderNote[]
    submissionReviews           SubmissionReview[]
    syncRunLogs                 SyncRunLog[]
    themeProjects               ThemeProject[]
    uploadHandoffs              UploadHandoff[]
    userDays                    UserDay[]
    userRoles                   UserRole[]
    userWeeks                   UserWeek[]
    contentReports              ContentReport[]              @relation(name: "content_report_reporterId_fkey")
    contentReportsContentReport ContentReport[]              @relation(name: "content_report_targetUserId_fkey")
    shopRegion                  ShopRegion?                  @relation(fields: [shopRegionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "user_shopRegionId_fkey", index: false)

    @@index([createdAt], map: "user_createdAt_idx")
    @@index([email], map: "user_email_key", unique: true)
    @@index([hackatimeUserId], map: "user_hackatimeUserId_key", unique: true)
    @@index([slackId], map: "user_slackId_key", unique: true)
    @@map("user")
  }

  model Account {
    id                    String              @id(map: "account_pkey")
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  TimestampString(3)?
    refreshTokenExpiresAt TimestampString(3)?
    scope                 String?
    password              String?
    createdAt             TimestampString(3)  @default(now())
    updatedAt             TimestampString(3)
    user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "account_userId_fkey")

    @@index([providerId, accountId], map: "account_providerId_accountId_key", unique: true)
    @@index([userId], map: "account_userId_idx")
    @@map("account")
  }

  model AriWebhookDelivery {
    id              String              @id(map: "ari_webhook_delivery_pkey")
    deliveryId      String
    event           String
    ariSubmissionId String?
    externalId      String?
    receivedAt      TimestampString(3)  @default(now())
    appliedAt       TimestampString(3)?
    payload         Jsonb?

    @@index([appliedAt], map: "ari_webhook_delivery_appliedAt_idx")
    @@index([deliveryId], map: "ari_webhook_delivery_deliveryId_key", unique: true)
    @@index([receivedAt], map: "ari_webhook_delivery_receivedAt_idx")
    @@map("ari_webhook_delivery")
  }

  model AuditLog {
    id             String               @id(map: "audit_log_pkey")
    action         pg.enum(AuditAction)
    actorId        String?
    actorEmail     String?
    actorIp        String?
    actorUserAgent String?
    targetType     String?
    targetId       String?
    metadata       Jsonb?
    createdAt      TimestampString(3)   @default(now())

    @@index([action, createdAt], map: "audit_log_action_createdAt_idx")
    @@index([actorId, createdAt], map: "audit_log_actorId_createdAt_idx")
    @@index([createdAt], map: "audit_log_createdAt_idx")
    @@index([targetId], map: "audit_log_targetId_idx")
    @@map("audit_log")
  }

  model ThemeProject {
    id                       String               @id(map: "theme_project_pkey")
    userId                   String
    theme                    pg.enum(Theme)
    title                    String               @default("")
    description              String?
    coverImageKey            String?
    githubRepo               String?
    artifactLinks            Jsonb?
    designStatus             pg.enum(PhaseStatus) @default("draft")
    designReviewComments     String?
    designReviewedAt         TimestampString(3)?
    designReviewedById       String?
    buildStatus              pg.enum(PhaseStatus) @default("draft")
    buildReviewComments      String?
    buildReviewedAt          TimestampString(3)?
    buildReviewedById        String?
    tier                     Int?
    grantUsd                 Int?
    grantEmittedAt           TimestampString(3)?
    approvedHours            Float?
    approvedHoursAt          TimestampString(3)?
    submissionExtensionUntil TimestampString(3)?
    createdAt                TimestampString(3)   @default(now())
    updatedAt                TimestampString(3)
    deletedAt                TimestampString(3)?
    deletedById              String?
    bomSavingsUsd            Int?
    buildCoins               Int?
    designApprovedHours      Float?
    designApprovedHoursAt    TimestampString(3)?
    designBankedCoins        Int?
    designSpendableCoins     Int?
    requestedTier            Int?
    starterProjectId         String?
    bomTaxShippingUsd        Float?
    namedAt                  TimestampString(3)?
    warmupPhase              pg.enum(Phase)?
    repoSyncEnabled          Boolean              @default(false)
    repoSyncRepo             String?
    repoSyncedAt             TimestampString(3)?
    repoSyncError            String?
    repoSyncQueuedAt         TimestampString(3)?
    bomItems                 BomItem[]
    contentReports           ContentReport[]
    hackatimeLinks           HackatimeLink[]
    hcbGrantTopups           HcbGrantTopup[]
    ledgerEntries            LedgerEntry[]
    phaseSubmissions         PhaseSubmission[]
    posts                    Post[]
    publicReels              PublicReel[]
    repoSyncRuns             RepoSyncRun[]
    workSessions             WorkSession[]
    user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "theme_project_userId_fkey")

    @@index([buildStatus], map: "theme_project_buildStatus_idx")
    @@index([designStatus], map: "theme_project_designStatus_idx")
    @@index([userId], map: "theme_project_userId_idx")
    @@index([userId, theme], map: "theme_project_userId_theme_key", where: sql`((theme <> 'WARMUP'::"Theme") AND ("deletedAt" IS NULL))`, unique: true)
    @@map("theme_project")
  }

  model BomItem {
    id             String             @id(map: "bom_item_pkey")
    themeProjectId String
    name           String
    purpose        String?
    quantity       Int                @default(1)
    unitCostUsd    Float              @default(0)
    vendor         String?
    link           String?
    sortOrder      Int                @default(0)
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3)
    themeProject   ThemeProject       @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "bom_item_themeProjectId_fkey", index: "bom_item_themeProjectId_sortOrder_idx")

    @@index([themeProjectId, sortOrder], map: "bom_item_themeProjectId_sortOrder_idx")
    @@map("bom_item")
  }

  model Post {
    id              String              @id(map: "post_pkey")
    userId          String
    themeProjectId  String?
    caption         String
    objectKey       String
    thumbnailKey    String?
    contentType     String?
    byteSize        Int?
    durationSeconds Int?
    width           Int?
    height          Int?
    status          pg.enum(PostStatus) @default("PROCESSING")
    publishedAt     TimestampString(3)?
    viewCount       Int                 @default(0)
    hiddenAt        TimestampString(3)?
    hiddenById      String?
    hiddenReason    String?
    weekNumber      Int?
    createdAt       TimestampString(3)  @default(now())
    updatedAt       TimestampString(3)
    deletedAt       TimestampString(3)?
    commentCount    Int                 @default(0)
    kind            pg.enum(PostKind)   @default("FREEFORM")
    likeCount       Int                 @default(0)
    pinnedAt        TimestampString(3)?
    checkpointKey   String?
    contentReports  ContentReport[]
    postComments    PostComment[]
    postLikes       PostLike[]
    postViews       PostView[]
    publicReels     PublicReel[]
    themeProject    ThemeProject?       @relation(fields: [themeProjectId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "post_themeProjectId_fkey")
    user            User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_userId_fkey", index: "post_userId_checkpointKey_idx")

    @@index([status, publishedAt], map: "post_status_publishedAt_idx")
    @@index([themeProjectId], map: "post_themeProjectId_idx")
    @@index([themeProjectId, kind], map: "post_themeProjectId_kind_idx")
    @@index([userId, checkpointKey], map: "post_userId_checkpointKey_idx")
    @@index([userId, createdAt], map: "post_userId_createdAt_idx")
    @@map("post")
  }

  model PostComment {
    id             String              @id(map: "post_comment_pkey")
    postId         String
    userId         String
    body           String
    hiddenAt       TimestampString(3)?
    hiddenById     String?
    hiddenReason   String?
    createdAt      TimestampString(3)  @default(now())
    updatedAt      TimestampString(3)
    deletedAt      TimestampString(3)?
    contentReports ContentReport[]
    post           Post                @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_comment_postId_fkey", index: "post_comment_postId_createdAt_idx")
    user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_comment_userId_fkey")

    @@index([postId, createdAt], map: "post_comment_postId_createdAt_idx")
    @@index([userId], map: "post_comment_userId_idx")
    @@map("post_comment")
  }

  model WorkSession {
    id                String               @id(map: "work_session_pkey")
    themeProjectId    String
    phase             pg.enum(Phase)
    title             String
    content           String?
    hoursClaimed      Float
    hoursApproved     Float?
    hoursSource       pg.enum(HoursSource) @default("MANUAL")
    effectiveDate     String?
    weekNumber        Int?
    reviewComments    String?
    reviewedAt        TimestampString(3)?
    reviewedById      String?
    createdAt         TimestampString(3)   @default(now())
    updatedAt         TimestampString(3)
    deletedAt         TimestampString(3)?
    contentReports    ContentReport[]
    sessionMedias     SessionMedia[]
    sessionTimelapses SessionTimelapse[]
    themeProject      ThemeProject         @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "work_session_themeProjectId_fkey", index: "work_session_themeProjectId_createdAt_idx")

    @@index([effectiveDate], map: "work_session_effectiveDate_idx")
    @@index([themeProjectId, createdAt], map: "work_session_themeProjectId_createdAt_idx")
    @@index([themeProjectId, phase], map: "work_session_themeProjectId_phase_idx")
    @@map("work_session")
  }

  model ContentReport {
    id             String                @id(map: "content_report_pkey")
    reporterId     String
    target         pg.enum(ReportTarget)
    reason         pg.enum(ReportReason)
    details        String?
    postId         String?
    commentId      String?
    themeProjectId String?
    targetUserId   String?
    workSessionId  String?
    status         pg.enum(ReportStatus) @default("OPEN")
    resolvedAt     TimestampString(3)?
    resolvedById   String?
    createdAt      TimestampString(3)    @default(now())
    updatedAt      TimestampString(3)
    comment        PostComment?          @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "content_report_commentId_fkey", index: false)
    post           Post?                 @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "content_report_postId_fkey", index: false)
    reporter       User                  @relation(name: "content_report_reporterId_fkey", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "content_report_reporterId_fkey")
    targetUser     User?                 @relation(name: "content_report_targetUserId_fkey", fields: [targetUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "content_report_targetUserId_fkey", index: false)
    themeProject   ThemeProject?         @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "content_report_themeProjectId_fkey", index: false)
    workSession    WorkSession?          @relation(fields: [workSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "content_report_workSessionId_fkey", index: false)

    @@index([reporterId, commentId], map: "content_report_open_comment_idx", where: sql`((status = 'OPEN'::"ReportStatus") AND ("commentId" IS NOT NULL))`, unique: true)
    @@index([reporterId, postId], map: "content_report_open_post_idx", where: sql`((status = 'OPEN'::"ReportStatus") AND ("postId" IS NOT NULL))`, unique: true)
    @@index([reporterId, themeProjectId], map: "content_report_open_project_idx", where: sql`((status = 'OPEN'::"ReportStatus") AND ("themeProjectId" IS NOT NULL))`, unique: true)
    @@index([reporterId, workSessionId], map: "content_report_open_session_idx", where: sql`((status = 'OPEN'::"ReportStatus") AND ("workSessionId" IS NOT NULL))`, unique: true)
    @@index([reporterId, targetUserId], map: "content_report_open_user_idx", where: sql`((status = 'OPEN'::"ReportStatus") AND ("targetUserId" IS NOT NULL))`, unique: true)
    @@index([reporterId], map: "content_report_reporterId_idx")
    @@index([status, createdAt], map: "content_report_status_createdAt_idx")
    @@map("content_report")
  }

  model HackatimeLink {
    id               String              @id(map: "hackatime_link_pkey")
    themeProjectId   String
    hackatimeProject String
    phase            pg.enum(Phase)      @default("BUILD")
    hoursApproved    Float?
    reviewedAt       TimestampString(3)?
    reviewedById     String?
    cachedSeconds    Int?
    cachedAt         TimestampString(3)?
    lastFetchError   String?
    createdAt        TimestampString(3)  @default(now())
    cachedSpans      Jsonb?
    spansFetchedAt   TimestampString(3)?
    spansFetchError  String?
    themeProject     ThemeProject        @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "hackatime_link_themeProjectId_fkey", index: "hackatime_link_themeProjectId_hackatimeProject_key")

    @@index([cachedAt], map: "hackatime_link_cachedAt_idx", where: sql`("hoursApproved" IS NULL)`)
    @@index([themeProjectId, hackatimeProject], map: "hackatime_link_themeProjectId_hackatimeProject_key", unique: true)
    @@index([themeProjectId, phase], map: "hackatime_link_themeProjectId_phase_idx")
    @@map("hackatime_link")
  }

  model HcbGrantTopup {
    id             String              @id(map: "hcb_grant_topup_pkey")
    userId         String
    themeProjectId String
    phase          pg.enum(Phase)
    grantHashid    String
    amountCents    Int
    transactionId  String?
    sentAt         TimestampString(3)?
    error          String?
    createdAt      TimestampString(3)  @default(now())
    createdById    String?
    themeProject   ThemeProject        @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "hcb_grant_topup_themeProjectId_fkey", index: false)
    user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "hcb_grant_topup_userId_fkey", index: "hcb_grant_topup_userId_themeProjectId_phase_key")

    @@index([grantHashid], map: "hcb_grant_topup_grantHashid_key", unique: true)
    @@index([userId, themeProjectId, phase], map: "hcb_grant_topup_userId_themeProjectId_phase_key", unique: true)
    @@map("hcb_grant_topup")
  }

  model HelpTicket {
    id            String              @id(map: "help_ticket_pkey")
    authorSlackId String
    helpChannel   String
    helpTs        String
    createdAt     TimestampString(3)  @default(now())
    resolvedAt    TimestampString(3)?
    resolvedBy    String?

    @@index([authorSlackId, createdAt], map: "help_ticket_authorSlackId_createdAt_idx")
    @@index([helpChannel, helpTs], map: "help_ticket_helpChannel_helpTs_key", unique: true)
    @@index([resolvedAt], map: "help_ticket_resolvedAt_idx")
    @@map("help_ticket")
  }

  model ShopItem {
    id                       String                    @id(map: "shop_item_pkey")
    name                     String
    description              String
    imageUrl                 String?
    category                 pg.enum(ShopItemCategory) @default("PRINTER_UPGRADE")
    priceCredits             Int
    maxPerUser               Int                       @default(1)
    stock                    Int?
    requiresPrinterQualified Boolean                   @default(true)
    active                   Boolean                   @default(true)
    sortOrder                Int                       @default(0)
    createdAt                TimestampString(3)        @default(now())
    updatedAt                TimestampString(3)
    costUsd                  Float?
    shopItemRegionPrices     ShopItemRegionPrice[]
    shopOrders               ShopOrder[]

    @@index([active, sortOrder], map: "shop_item_active_sortOrder_idx")
    @@map("shop_item")
  }

  model ShopOrder {
    id                   String                          @id(map: "shop_order_pkey")
    orderNumber          Int                             @default(autoincrement())
    userId               String
    shopItemId           String
    quantity             Int
    unitCredits          Int
    totalCredits         Int
    itemNameSnapshot     String
    status               pg.enum(ShopOrderStatus)        @default("PENDING")
    holdReason           String?
    rejectionReason      String?
    encryptedAddress     String                          @default("")
    encryptedPhone       String                          @default("")
    trackingNumber       String?
    trackingCarrier      String?
    placedAt             TimestampString(3)              @default(now())
    heldAt               TimestampString(3)?
    rejectedAt           TimestampString(3)?
    fulfilledAt          TimestampString(3)?
    lastActorId          String?
    fulfillmentMethod    pg.enum(ShopFulfillmentMethod)?
    fulfillmentStage     pg.enum(ShopFulfillmentStage)   @default("UNFULFILLED")
    fulfillmentUpdatedAt TimestampString(3)?
    unitCostUsd          Float?
    idempotencyKey       String?
    stockDebited         Boolean?
    ledgerEntries        LedgerEntry[]
    shopOrderNotes       ShopOrderNote[]
    shopItem             ShopItem                        @relation(fields: [shopItemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "shop_order_shopItemId_fkey")
    user                 User                            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "shop_order_userId_fkey")

    @@index([orderNumber], map: "shop_order_orderNumber_key", unique: true)
    @@index([shopItemId], map: "shop_order_shopItemId_idx")
    @@index([status, placedAt], map: "shop_order_status_placedAt_idx")
    @@index([userId, idempotencyKey], map: "shop_order_userId_idempotencyKey_key", unique: true)
    @@index([userId], map: "shop_order_userId_idx")
    @@map("shop_order")
  }

  model LedgerEntry {
    id             String              @id(map: "ledger_entry_pkey")
    userId         String
    themeProjectId String?
    kind           pg.enum(LedgerKind)
    amount         Int
    note           String?
    balanceBefore  Int
    balanceAfter   Int
    shopOrderId    String?
    createdById    String?
    createdAt      TimestampString(3)  @default(now())
    bucket         pg.enum(CoinBucket) @default("SPENDABLE")
    shopOrder      ShopOrder?          @relation(fields: [shopOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "ledger_entry_shopOrderId_fkey", index: "ledger_entry_shopOrderId_kind_bucket_key")
    themeProject   ThemeProject?       @relation(fields: [themeProjectId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "ledger_entry_themeProjectId_fkey", index: false)
    user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ledger_entry_userId_fkey", index: "ledger_entry_userId_bucket_idx")

    @@index([shopOrderId, kind, bucket], map: "ledger_entry_shopOrderId_kind_bucket_key", unique: true)
    @@index([userId, bucket], map: "ledger_entry_userId_bucket_idx")
    @@index([userId, createdAt], map: "ledger_entry_userId_createdAt_idx")
    @@index([userId, themeProjectId, kind], map: "ledger_entry_userId_themeProjectId_kind_idx")
    @@map("ledger_entry")
  }

  model PhaseSubmission {
    id                     String                 @id(map: "phase_submission_pkey")
    themeProjectId         String
    phase                  pg.enum(Phase)
    notes                  String?
    submittedInWeek        Int?
    scheduledWeek          Int?
    onTime                 Boolean                @default(false)
    preReviewed            Boolean                @default(false)
    preReviewedAt          TimestampString(3)?
    resolvedAt             TimestampString(3)?
    resolvedResult         pg.enum(ReviewResult)?
    createdAt              TimestampString(3)     @default(now())
    attachmentKeys         String?[]?             @default([])
    ariDecision            String?
    ariStatus              String?
    ariSubmissionId        String?
    ariSyncedAt            TimestampString(3)?
    partialFundingAccepted Boolean                @default(false)
    requestedBomUsd        Float?
    fundingCapUsd          Int?
    ariShipError           String?
    fundingDeclined        Boolean                @default(false)
    ariStatusAt            TimestampString(3)?
    reviewClaim            ReviewClaim?
    reviewDispute          ReviewDispute?
    submissionReviews      SubmissionReview[]
    themeProject           ThemeProject           @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "phase_submission_themeProjectId_fkey")

    @@index([resolvedAt, createdAt], map: "phase_submission_resolvedAt_createdAt_idx")
    @@index([themeProjectId], map: "phase_submission_themeProjectId_idx")
    @@index([themeProjectId, phase, createdAt], map: "phase_submission_themeProjectId_phase_createdAt_idx")
    @@map("phase_submission")
  }

  model PostLike {
    id        String             @id(map: "post_like_pkey")
    postId    String
    userId    String
    createdAt TimestampString(3) @default(now())
    post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_like_postId_fkey", index: "post_like_postId_userId_key")
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_like_userId_fkey")

    @@index([postId, userId], map: "post_like_postId_userId_key", unique: true)
    @@index([userId], map: "post_like_userId_idx")
    @@map("post_like")
  }

  model PostView {
    id        String             @id(map: "post_view_pkey")
    postId    String
    userId    String
    createdAt TimestampString(3) @default(now())
    post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_view_postId_fkey", index: "post_view_postId_userId_key")
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "post_view_userId_fkey")

    @@index([postId, userId], map: "post_view_postId_userId_key", unique: true)
    @@index([userId], map: "post_view_userId_idx")
    @@map("post_view")
  }

  model PrinterAward {
    id                 String                      @id(map: "printer_award_pkey")
    userId             String
    qualifiedAt        TimestampString(3)
    qualifyingSnapshot Jsonb
