{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedEnumMembers": "on",
				"useSortedInterfaceMembers": "on",
				"useSortedKeys": "on",
				"useSortedPackageJson": "on",
				"useSortedProperties": "on",
				"useSortedSelectionSet": "on",
				"useSortedTypeFields": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"public/**",
			"!public/**/*.svg",
			"scripts/**",
			"e2e/**",
			"src/**",
			"!src/app/generated",
			".impeccable/**",
			".github/**",
			"prisma/**",
			"!prisma/migrations",
			"!migrations",
			"import/**",
			"!src/**/*.svg",
			"*.config.mjs",
			"*.config.ts",
			"*.json"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSameLine": false,
			"operatorLinebreak": "before",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		},
		"globals": ["Bun"]
	},
	"linter": {
		"rules": {
			"a11y": {
				"noNoninteractiveElementInteractions": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off",
				"noExcessiveLinesPerFunction": "off",
				"noPlaywrightUselessAwait": "off",
				"noVoid": "off",
				"useMaxParams": "off",
				"useSimplifiedLogicExpression": "off"
			},
			"correctness": {
				"noNodejsModules": "off",
				"noProcessGlobal": "off",
				"noReactNativeRawText": "off",
				"noSolidDestructuredProps": "off",
				"noUnresolvedImports": "off",
				"useExhaustiveDependencies": "off",
				"useImageSize": "off",
				"useImportExtensions": "off",
				"useQwikValidLexicalScope": "off",
				"useSingleJsDocAsterisk": "off",
				"useUniqueElementIds": "off"
			},
			"nursery": {
				"noAccidentalBitwiseOperators": "error",
				"noArgumentsCallerOrCallee": "error",
				"noArraySortForMinMax": "error",
				"noAstroConflictingSetDirectives": "error",
				"noAstroSetHtmlDirective": "error",
				"noBaseToString": "error",
				"noBooleanSortComparator": "error",
				"noBunModules": "off",
				"noDanglingUnderscore": "error",
				"noDoubleComparison": "error",
				"noDuplicateMapKeys": "error",
				"noEagerArrayMethodsInLoops": "off",
				"noExcessiveStatementsPerFunction": "off",
				"noExtendNative": "error",
				"noFloatingPromises": "error",
				"noImpliedEval": "error",
				"noInvalidFileInputAccept": "off",
				"noInvalidPropertyInitValue": "error",
				"noInvalidThis": "error",
				"noJsonUnsafeValues": "error",
				"noJsRestrictedProperties": "error",
				"noMeaninglessVoidOperator": "error",
				"noMisleadingReturnType": "off",
				"noMisplacedListElements": "error",
				"noMisusedPromises": "off",
				"noNegationInEqualityCheck": "error",
				"noNestedSwitch": "error",
				"noNestedTemplateLiterals": "off",
				"noNewRequire": "error",
				"noNonScalableViewport": "error",
				"noObjectConstructor": "error",
				"noObsoleteAttributes": "error",
				"noObsoleteTags": "error",
				"noOctal": "error",
				"noPathConcat": "error",
				"noPlaywrightNthMethods": "off",
				"noProcessExit": "off",
				"noPromiseExecutorReturn": "off",
				"noReactObjectTypeAsDefaultProp": "error",
				"noRestrictedDependencies": "off",
				"noReturnInFinally": "error",
				"noSelfImport": "error",
				"noSelfNestedLayer": "error",
				"noShortTimeValues": "error",
				"noSvelteAddEventListener": "error",
				"noSvelteAtDebugTags": "error",
				"noSvelteAtHtmlTags": "error",
				"noSvelteClassDirective": "error",
				"noSvelteExportLet": "error",
				"noSvelteInspect": "error",
				"noSvelteInternal": "error",
				"noSvelteLegacyConst": "error",
				"noSvelteObjectInTextMustaches": "error",
				"noSvelteUnnecessaryStateWrap": "error",
				"noSvelteUselessDerivedBy": "error",
				"noTailwindArbitraryValue": "off",
				"noTailwindLegacyUtilities": "off",
				"noTailwindRawColors": "error",
				"noTailwindRestyledComponents": "off",
				"noTanstackQueryRestDestructuring": "error",
				"noThisOutsideOfClass": "error",
				"noUndeclaredClasses": "off",
				"noUndeclaredCustomProperties": "off",
				"noUnmodifiedLoopCondition": "error",
				"noUnreadableForOfExpression": "off",
				"noUnsafeIframeSandbox": "error",
				"noUnsafePlusOperands": "error",
				"noUnsafeReturn": "error",
				"noUnsafeTypeAssertion": "off",
				"noUnsafeUnaryMinus": "error",
				"noUnusedClasses": "off",
				"noUselessAssignment": "off",
				"noUselessCall": "error",
				"noUselessDateGetTime": "error",
				"noUselessSplice": "error",
				"noUselessTypeConversion": "error",
				"noVueBooleanDefault": "error",
				"noVueDeprecatedScopedSlots": "error",
				"noVueLifecycleAfterAwait": "error",
				"noVueRequiredPropWithDefault": "error",
				"noVueRootVIf": "error",
				"noVueShadowNativeEvents": "error",
				"noVueUndeclaredDirectives": "error",
				"noVueUnusedEmitDeclarations": "error",
				"noVueVHtml": "error",
				"noVueVText": "error",
				"noVueVTextVHtmlOnComponent": "error",
				"noVueWatchAfterAwait": "error",
				"noXorAsExponentiation": "error",
				"noZeroFractions": "error",
				"noZeroLengthUnit": "off",
				"useAstroClientOnlyDirectiveValue": "error",
				"useAwaitThenable": "error",
				"useBetterDomTraversing": "error",
				"useBigintLiterals": "error",
				"useBlockStatementOverIife": "error",
				"useCapitalizedConstructors": "off",
				"useConsistentBlockLang": "error",
				"useConsistentFunctionStyle": "off",
				"useConsistentHeadingLevel": "error",
				"useConsistentJsonFileRead": "error",
				"useConsistentLightnessNotation": "error",
				"useConsistentObjectKeys": "error",
				"useConsistentUnicodeBom": "error",
				"useControlLabel": "error",
				"useDisposables": "error",
				"useExhaustiveSwitchCases": "error",
				"useExpectToContain": "error",
				"useExplicitReturnType": "off",
				"useExplicitType": "off",
				"useFencedCodeLanguage": "off",
				"useFlatMathMinMax": "error",
				"useIncludes": "error",
				"useIteratorZip": "error",
				"useLayeredStyles": "off",
				"useLogicalProperties": "off",
				"useLowercaseTestTitle": "off",
				"useMatchingFunctionName": "error",
				"useMathAbs": "error",
				"useMathTrunc": "error",
				"useModernMathApis": "error",
				"useNamedFunction": "error",
				"useNamedLayer": "error",
				"useNullishCoalescing": "off",
				"usePackageJsonValidCpu": "error",
				"usePackageJsonValidEngines": "error",
				"usePromiseRejectErrors": "error",
				"useReactCompiler": "off",
				"useReactFunctionComponentDefinition": "off",
				"useReactNamingConvention": "off",
				"useReactNativeValidPlatformColors": "error",
				"useRegexpExec": "error",
				"useSimplifiedBooleanReturn": "off",
				"useSingleTopLevelHeading": "error",
				"useStrictBooleanExpressions": "off",
				"useStringStartsEndsWith": "error",
				"useSvelteKitResolve": "error",
				"useSvelteKitRuneImports": "error",
				"useSvelteReactiveClasses": "error",
				"useSvelteRequireEachKey": "error",
				"useSvelteShorthandDirective": "error",
				"useTailwindShorthandClasses": "off",
				"useTailwindSortedClasses": "off",
				"useTailwindStaticClassStrings": "off",
				"useTopLevelHeading": "error",
				"useUnaryMinus": "error",
				"useValidTestTitle": "off",
				"useVueBaseImport": "error",
				"useVueComponentIs": "error",
				"useVueConsistentEventHyphenation": "error",
				"useVueMatchingComponentFileName": "error",
				"useVueToggleInsideTransition": "error",
				"useVueTypedRef": "error",
				"useVueVOnExact": "error"
			},
			"performance": {
				"noAwaitInLoops": "off",
				"noBarrelFile": "off",
				"noDelete": "off",
				"noImgElement": "off",
				"noJsxPropsBind": "off",
				"useSolidForComponent": "off",
				"useTopLevelRegex": "off"
			},
			"preset": "all",
			"security": {
				"noDangerouslySetInnerHtml": "off",
				"noSecrets": "off"
			},
			"style": {
				"noContinue": "off",
				"noDefaultExport": "off",
				"noEnum": "off",
				"noExcessiveLinesPerFile": "off",
				"noHexColors": "off",
				"noImplicitBoolean": "off",
				"noIncrementDecrement": "off",
				"noInlineStyles": "off",
				"noJsxLiterals": "off",
				"noMagicNumbers": "off",
				"noNegationElse": "off",
				"noNestedTernary": "off",
				"noParameterProperties": "off",
				"noProcessEnv": "off",
				"noReactNativeLiteralColors": "off",
				"noTernary": "off",
				"useBlockStatements": "off",
				"useComponentExportOnlyModules": "off",
				"useConsistentCurlyBraces": "off",
				"useConsistentMethodSignatures": "off",
				"useConsistentTestIt": "off",
				"useConsistentTypeDefinitions": "off",
				"useDefaultSwitchClause": "off",
				"useErrorCause": "off",
				"useExportsLast": "off",
				"useFilenamingConvention": "off",
				"useGlobalThis": "off",
				"useNamedCaptureGroup": "off",
				"useNamingConvention": "off",
				"useNumericSeparators": "off",
				"useObjectSpread": "off",
				"useUnicodeRegex": "off"
			},
			"suspicious": {
				"noAlert": "off",
				"noArrayIndexKey": "off",
				"noBitwiseOperators": "off",
				"noConditionalExpect": "off",
				"noConsole": "off",
				"noDuplicateSelectors": "off",
				"noEmptyBlockStatements": "off",
				"noEqualsToNull": "off",
				"noImportCycles": "off",
				"noJsxLeakedDollar": "off",
				"noLeakedRender": "off",
				"noLoopFunc": "off",
				"noPlaywrightForceOption": "off",
				"noReactForwardRef": "off",
				"noReactSpecificProps": "off",
				"noReturnAssign": "off",
				"noShadow": "off",
				"noUnnecessaryConditions": "off",
				"useArraySortCompare": "off",
				"useBaseline": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["e2e/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noEmptyPattern": "off"
					}
				}
			}
		},
		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": "off"
					}
				}
			},
			"includes": ["package.json"]
		}
	],
	"yaml": {
		"formatter": {
			"indentWidth": 4
		}
	}
}
