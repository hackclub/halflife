		"better-auth": "1.7.13",
		"isomorphic-dompurify": "^4.6.0",
		"kysely": "^0.29.7",
		"next": "^16.4.3",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "1.0.0",
		"bun-types": "^1.4.4",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.3.8",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"prisma": "^8.0.0-rc.27",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
