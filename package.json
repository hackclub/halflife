{
	"name": "halflife",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"airtable:backfill-justification": "bun --conditions=react-server scripts/backfill-airtable-justification.ts",
		"airtable:backfill-project-week": "bun --conditions=react-server scripts/backfill-airtable-project-week.ts",
		"airtable:backfill-review": "bun --conditions=react-server scripts/backfill-airtable-review.ts",
		"airtable:backfill-reviewers": "bun --conditions=react-server scripts/backfill-airtable-reviewers.ts",
		"airtable:backfill-starters": "bun --conditions=react-server scripts/backfill-airtable-starters.ts",
		"analytics:backfill": "bun --conditions=react-server scripts/backfill-analytics.ts",
		"ari:audit-log": "bun scripts/ari-audit-log.ts",
		"ari:backfill-empty-journals": "bun --conditions=react-server scripts/backfill-ari-empty-journals.ts",
		"ari:backfill-timelapses": "bun --conditions=react-server scripts/backfill-ari-timelapses.ts",
		"ari:resend-all": "bun scripts/ari-resend-all.ts",
		"ari:review-counts": "bun --conditions=react-server scripts/ari-review-counts.ts",
		"build": "next build",
		"db:deploy": "prisma db migrate",
		"db:generate": "prisma contract emit && bun scripts/generate-enums.ts && biome check --write src/lib/enums.ts",
		"db:migrate": "prisma db migrate",
		"db:plan": "prisma migration plan",
		"db:seed": "bun --conditions=react-server prisma/seed.ts",
		"db:sign": "prisma db sign",
		"db:update": "prisma db update",
		"db:verify": "prisma db verify",
		"dev": "next dev",
		"dev:e2e": "next dev -p 3100",
