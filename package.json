		"e2e:db": "bun scripts/e2e-db.ts",
		"e2e:install": "playwright install --with-deps chromium",
		"grant-role": "bun scripts/grant-role.ts",
		"hca:backfill-display-names": "bun --conditions=react-server scripts/backfill-display-names.ts",
		"hours:backfill-overlap": "bun --conditions=react-server scripts/backfill-timelapse-overlap.ts",
		"import:check": "bun import/check.ts",
		"import:dump": "bun --env-file=import/.env import/dump.ts",
		"import:stasis": "bun --env-file=import/.env --env-file=.env import/stasis.ts",
		"lint": "oxlint; biome check",
		"lint:fix": "oxlint --fix; biome check --fix",
		"loops:backfill": "bun --conditions=react-server scripts/backfill-loops.ts",
		"loops:backfill-review-overrides": "bun --conditions=react-server scripts/backfill-loops-review-overrides.ts",
		"loops:backfill-submitted": "bun --conditions=react-server scripts/backfill-loops-submitted.ts",
		"p8:contract:emit": "prisma contract emit && bun scripts/generate-enums.ts && biome check --write src/lib/enums.ts",
		"p8:verify": "bun --conditions=react-server scripts/verify-prisma8.ts",
		"reviews:backfill-ari": "bun --conditions=react-server scripts/backfill-ari-reviews.ts",
		"reviews:backfill-identities": "bun --conditions=react-server scripts/backfill-review-identities.ts",
		"reviews:backfill-return-extensions": "bun --conditions=react-server scripts/backfill-return-extensions.ts",
		"reviews:repair-ari": "bun --conditions=react-server scripts/repair-ari-decisions.ts",
		"reviews:repair-identity-returns": "bun --conditions=react-server scripts/repair-identity-returns.ts",
		"reviews:unreviewed-starbies": "bun --conditions=react-server scripts/list-unreviewed-starbies.ts",
		"seed-help-calls": "bun --conditions=react-server scripts/seed-help-calls.ts",
		"slack:backfill-tickets": "bun --conditions=react-server scripts/backfill-slack-tickets.ts",
		"start": "next start",
		"start:e2e": "next start -p 3100",
		"starters:backfill-week-3": "bun --conditions=react-server scripts/backfill-week-3-starters.ts",
		"streaks:recompute": "bun --conditions=react-server scripts/recompute-streaks.ts",
		"test": "bun test --conditions=react-server src",
		"test:coverage": "bun test --conditions=react-server --coverage src",
		"test:e2e": "bun run e2e:db && playwright test",
		"test:e2e:only": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "tsc --noEmit",
		"uploads:backfill-urls": "bun --conditions=react-server scripts/backfill-upload-urls.ts",
		"uploads:migrate-legacy": "bun scripts/migrate-legacy-uploads.ts",
		"verify:contracts": "bun --conditions=react-server scripts/verify-contracts.ts",
		"verify:feed": "bun --conditions=react-server scripts/verify-feed.ts",
		"verify:forge-write": "bun --conditions=react-server scripts/verify-forge-write.ts",
		"verify:handoff": "bun --conditions=react-server scripts/verify-handoff.ts",
		"verify:ledger": "bun --conditions=react-server scripts/verify-ledger.ts",
		"verify:loops": "bun --conditions=react-server scripts/verify-loops.ts",
		"verify:loops-entries": "bun --conditions=react-server scripts/verify-loops-entries.ts",
		"verify:onboarding": "bun --conditions=react-server scripts/verify-onboarding.ts",
		"verify:pii": "bun --conditions=react-server scripts/verify-pii.ts",
		"verify:store": "bun --conditions=react-server scripts/verify-store.ts",
		"verify:uploads": "bun --conditions=react-server scripts/verify-uploads.ts"
	},
	"overrides": {
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.14",
		"lodash": "^4.18.1",
		"valibot": "^1.5.0",
		"zod": "^4.6.7"
	},
