// Half-Life - Hack Club YSWS hardware program platform.
//
// Postgres is the source of truth for everything transactional. Airtable holds the RSVP funnel and the `YSWS Project Submission` rows the Hack Club payout pipeline reads; it is a sink, never a store.
//
// Convention: tables are @@map'd to snake_case, columns stay camelCase.

generator client {
  provider        = "prisma-client"
  output          = "../src/app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// Prisma 7 takes the connection URL from prisma.config.ts (for the CLI) and from the driver adapter passed to PrismaClient (at runtime), not from here.
datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// The five themed tracks, in program order. A theme's ordinal position is its design week (PCB = design week 1, build week 6). Do not reorder.
enum Theme {
  PCB
  CAD
  SYNTH
  DISPLAYS
  BREADBOARD_COMPUTER
  /// A project submitted during the pre-season warm-up weeks, through the Fillout form, and imported off the `YSWS Project Submission` table. Not a season track: it has no scheduled week, does not count toward printer qualification, and exists so warm-up projects do not occupy any of the maker's five season slots. Unlike a season theme it is not unique per maker - the warm-up form may have been filled in more than once, and every row is a project of its own (see `@@unique` below).
  WARMUP
}

enum Phase {
  DESIGN
  BUILD
}

/// Lifecycle of one (ThemeProject, Phase).
enum PhaseStatus {
  draft
  in_review
  update_requested
  approved
  rejected
}

enum ReviewResult {
  APPROVED
  RETURNED
  REJECTED
}

/// Which pass of the review pipeline a review row belongs to.
///
/// v1 runs single-pass: a REVIEWER decides directly and every row is FINAL. The column exists from day one so turning on a volunteer first pass later (advisory review that moves no status and no money, then an admin finalizes) is a routing change rather than a migration.
enum ReviewPass {
  FIRST
  FINAL
}

/// Where a work session's hours come from.
///
/// HACKATIME_TRACKED sessions contribute ZERO to the journal total: their time already arrives through a HackatimeLink. Without this distinction, someone who writes firmware, journals "4h on firmware", and links the Hackatime project is paid for eight hours of work they did once.
enum HoursSource {
  MANUAL
  HACKATIME_TRACKED
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Which pot a ledger row moves coins in or out of.
///
/// BANKED is the printer fund: coins the program forces a participant to save (a tier's `bankHours` on every approved design) and which can only ever be spent on a printer. Without this split, someone could spend the lot on filament in week 3 and finish the program with nothing to print on, which is the exact outcome the forced-savings rule exists to prevent.
///
/// The two balances are separate SUMs over this column, never a single total with a reserved portion subtracted - a reserve you have to remember to subtract is a reserve some query will forget.
enum CoinBucket {
  SPENDABLE
  BANKED
}

/// Ledger entry kinds.
///
/// There is deliberately no *_REVERSED twin of any kind. A reversal is a negative row of the same kind, so `SUM(amount) GROUP BY kind` is correct by construction. Stasis learned this the hard way: because DESIGN_APPROVED and DESIGN_APPROVED_REVERSED are separate values, every aggregate over the ledger has to remember to include the twin, and lib/currency.ts carries a long comment about the one that forgot and overcounted forever.
enum LedgerKind {
  DESIGN_BANKED_HOURS // the goal's weekly banking, forced into the printer fund
  DESIGN_EXCESS_HOURS // design hours beyond funding + banking, freely spendable
  BUILD_BANKED_HOURS // a build week's flat contribution to the printer fund
  BUILD_HOURS // build hours beyond that, freely spendable
  BOM_SAVINGS // dollars left unspent on the parts order
  THEME_COMPLETION_BONUS // flat award for shipping a theme (design + build approved)
  PARTS_TOP_UP // negative; extra parts money charged against coins
  ADMIN_ADJUSTMENT // manual grant or clawback, signed
  REVIEWER_PAYMENT // compensation for review work
  SHOP_PURCHASE // always negative
  SHOP_REFUND // always positive, nets a SHOP_PURCHASE
}

enum ShopItemCategory {
  /// A printer itself. The only category BANKED coins may be spent on.
  PRINTER
  PRINTER_UPGRADE
  CONSUMABLE
  MISC
}

/// Self-reported, from the first onboarding question.
///
/// Its only mechanical effect is which funding tier the tier step highlights: the comp's own note says the answer "will highlight appropriate funding tier when the choice shows up". It never gates anything - the copy under the question promises "this will have no effect on your experience, it's just for us", and a field that quietly did gate something would make that line a lie.
enum HardwareExperience {
  FIRST_TIME
  A_LITTLE
  A_GOOD_AMOUNT
  ITS_LIFE
}

/// What a participant is actually here for, asked once the first checkpoint is done and answered before the platform lets them carry on.
///
/// It is the one question the program has to ask up front, because the three answers want different things from the same ten weeks: a printer is a target to pace against, funding is the grant itself, and there is no prize-shaped version of "I'd like some of it".
///
/// Deliberately NOT an extension of `printerGoalId`. That column answers "which machine", which is a question only the PRINTER branch ever asks; this one answers "why am I here", and it gates whether the machine question is asked at all. An enum and not a string because these three are the program's own vocabulary and staff report on them by name.
enum ParticipantGoal {
  /// A 3D printer at the end of the season - the only answer that takes a `printerGoalId`.
  PRINTER
  /// The per-project funding grant, for the whole ten weeks.
  FULL_FUNDING
  /// The same grant, for some of the tenAdd extra histogram bars for share of total hours per bucket weeks rather than all of them.
  PARTIAL_FUNDING
}

/// What a reel is FOR.
///
/// The design file's checkpoint note makes reels part of the week's required sequence rather than a social extra - "idea reel", "progress reel", "final submission reel" each appear as steps a participant has to clear. Storing the kind is what lets a checkpoint ask "has this project posted its idea reel yet" without guessing from timestamps.
///
/// ANNOUNCEMENT is ours, not a participant's: the note says the doomscroll's "first reel should be our updates from HQ".
enum PostKind {
  IDEA
  PROGRESS
  SUBMISSION
  FREEFORM
  ANNOUNCEMENT
}

enum PostStatus {
  /// Uploaded to R2, not yet playable (thumbnail/duration still unknown).
  PROCESSING
  PUBLISHED
  /// Taken out of the feed by a moderator; still visible to its author.
  HIDDEN
  REMOVED
}

/// What kind of user-generated thing a content report is about. One report points at exactly one of the five; the matching FK is set and the rest are null, checked in the route rather than the schema.
enum ReportTarget {
  REEL
  REEL_COMMENT
  PROJECT
  USER
  DEVLOG
}

/// Why something was reported. A fixed set so the queue triages at a glance; the free-form `details` on the report carries the rest.
enum ReportReason {
  EXCESSIVE_AI_USE
  MISCONDUCT
  SPAM
  OTHER
}

/// Where a report stands. OPEN is the queue; RESOLVED means staff reviewed it and took whatever action fit (possibly none beyond looking); DISMISSED means no violation.
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Where a participant posted their reel outside Half Life.
enum PublicReelPlatform {
  INSTAGRAM
  TIKTOK
  X
  YOUTUBE
}

enum ShopOrderStatus {
  PENDING
  ON_HOLD
  FULFILLED
  REJECTED
  CANCELLED
}

/// How an order gets to the participant: straight from the vendor, or bought in bulk to HQ and shipped on from there.
enum ShopFulfillmentMethod {
  DIRECT_SHIP
  BULK_TO_HQ
}

/// Where an order is in fulfilment. Separate from ShopOrderStatus, which is the approve/reject decision and the refund that hangs off it. An order the participant cancelled always reads as CANCELLED, whatever is stored here.
enum ShopFulfillmentStage {
  UNFULFILLED
  ORDERED_TO_HQ
  SENT_FOR_DELIVERY
  CANCELLED
}

/// The colour an event wears on the calendar. A short, fixed set because the whole point of it is that the calendar can be read at a glance - the weekly call has to look different from show & tell.
///
/// Stored as a colour rather than a kind because the colour is the only thing a participant sees: the kind was a label nobody read, and the two always agreed.
enum EventColour {
  CORAL
  SKY
  VIOLET
  GOLD
  TEAL
  SLATE
}

enum PrinterAwardStatus {
  QUALIFIED
  ADDRESS_LOCKED
  PACKING
  SHIPPED
  DELIVERED
  REVOKED
}

enum Role {
  ADMIN
  REVIEWER
  FULFILLER // ships shop orders and printers; cannot review or mint credit
  AUDITOR // read-only oversight
}

enum AuditAction {
  // Participant
  USER_UPDATE_PROJECT
  USER_DELETE_PROJECT
  USER_SUBMIT_PHASE
  USER_UNSUBMIT_PHASE
  USER_CREATE_SESSION
  USER_UPDATE_SESSION
  USER_DELETE_SESSION
  USER_LINK_HACKATIME
  USER_UNLINK_HACKATIME
  USER_PLACE_ORDER
  USER_CREATE_POST
  /// A reel post the server refused. Carries the code and its reason, because the client is shown that reason and nothing else would ever record that it was shown.
  USER_CREATE_POST_FAILED
  USER_DELETE_POST
  USER_HANDOFF_UPLOAD
  USER_COMMENT_POST
  USER_DELETE_COMMENT
  USER_ADVANCE_ONBOARDING
  USER_SET_PRINTER_GOAL
  /// The participant's answer to "what are you here for". Carries the previous answer in its metadata, since the only interesting fact about this one is what it changed.
  USER_SET_PARTICIPANT_GOAL
  USER_COMPLETE_ONBOARDING
  USER_DISPUTE_REVIEW
  /// A participant flagging a reel, comment, project, user or devlog for staff.
  USER_CREATE_REPORT

  // Review
  REVIEW_CLAIM
  REVIEW_RELEASE
  REVIEW_APPROVE
  REVIEW_RETURN
  REVIEW_REJECT
  REVIEW_APPROVE_HOURS
  ADMIN_UNAPPROVE_PHASE
  ADMIN_REOPEN_PHASE

  // Admin
  ADMIN_GRANT_ROLE
  ADMIN_REVOKE_ROLE
  ADMIN_FLAG_FRAUD
  ADMIN_UNFLAG_FRAUD
  /// An admin replacing the address on a user's row. Carries both addresses in its metadata: which one it was is the whole question when someone asks why a participant stopped getting mail.
  ADMIN_CHANGE_EMAIL
  ADMIN_GRANT_EXTENSION
  ADMIN_MOVE_PROJECT
  ADMIN_ADJUST_CREDIT
  ADMIN_DELETE_PROJECT
  ADMIN_RESTORE_PROJECT
  ADMIN_CREATE_SHOP_ITEM
  ADMIN_UPDATE_SHOP_ITEM
  ADMIN_RETIRE_SHOP_ITEM
  ADMIN_CREATE_SHOP_REGION
  ADMIN_UPDATE_SHOP_REGION
  ADMIN_SET_REGION_PRICE
  ADMIN_FULFILL_ORDER
  ADMIN_REJECT_ORDER
  ADMIN_UPDATE_ORDER_FULFILLMENT
  ADMIN_UPDATE_PROGRAM_SETTINGS
  ADMIN_HIDE_POST
  ADMIN_RESTORE_POST
  ADMIN_HIDE_COMMENT
  ADMIN_PIN_POST
  /// An admin putting themselves back at the start of the first checkpoint.
  ADMIN_RESET_ONBOARDING
  ADMIN_RESOLVE_DISPUTE
  /// A change to the programme calendar: one occurrence of a scheduled event. Repeating events are created in one request but logged as one action, carrying the occurrence count, because the series is the unit an admin meant.
  ADMIN_CREATE_PROGRAM_EVENT
  ADMIN_UPDATE_PROGRAM_EVENT
  ADMIN_DELETE_PROGRAM_EVENT
  /// A content report reviewed with action taken (or looked at and closed).
  ADMIN_RESOLVE_REPORT
  /// A content report closed as no violation.
  ADMIN_DISMISS_REPORT
  ADMIN_SEND_GRANT
  /// One warm-up Airtable row brought into Half Life (lib/airtable/warmup-import).
  ADMIN_IMPORT_AIRTABLE_PROJECT

  // Printer
  PRINTER_QUALIFIED
  PRINTER_STATUS_CHANGE
  PRINTER_REVOKED

  // Side-effect outcomes, so a silent failure becomes a queryable row
  AIRTABLE_SYNC_SUCCESS
  AIRTABLE_SYNC_FAILURE
  NOTIFICATION_FAILURE
  ARI_SYNC_SUCCESS
  ARI_SYNC_FAILURE
  /// An Ari webhook that changed local review state.
  ARI_WEBHOOK_APPLIED
  /// An Ari webhook that was understood but deliberately did nothing.
  ARI_WEBHOOK_IGNORED

  // System
  SYSTEM_HACKATIME_SYNC
  SYSTEM_CLAIM_SWEEP
  SYSTEM_RSVP_DRAIN

  // GitHub repo sync (devlogs + BOM into the maker's own repository)
  /// Turning the automatic sync on or off for a project.
  USER_UPDATE_REPO_SYNC
  /// One project's files written to GitHub, by the after-write job or by hand.
  REPO_SYNC_SUCCESS
  /// A write to GitHub that did not land. The reason is in the metadata.
  REPO_SYNC_FAILURE
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  /// How they are known on the site: HCA's `nickname` claim, copied here at every sign-in by lib/hca-profile. `name` deliberately keeps the full "first last" string - the Airtable RSVP and YSWS rows, Ari and the participant export split it into first and last and need the whole thing. Every renderer reads both through lib/display-name, which falls back to `name` while this is still null (a row from before this column existed).
  displayName   String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Hack Club identity, from HCA
  slackId            String? @unique
  slackDisplayName   String?
  hackatimeUserId    String? @unique
  /// Raw HCA verification_status. YSWS eligibility is gated on this at submit time, not at signup, so peo iple can explore the app before verifying.
  verificationStatus String?

  bio      String?
  pronouns String?
  timezone String?

  /// AES-256-GCM at rest via lib/pii.ts. Only populated when PULL_HCA_PII=true. Decrypted server-side at the moment of use (the grant row, a shipping label) and never selected into a client payload.
  encryptedAddressStreet  String?
  encryptedAddressLine2   String?
  encryptedAddressCity    String?
  encryptedAddressState   String?
  encryptedAddressZip     String?
  encryptedAddressCountry String?
  encryptedBirthday       String?
  encryptedPhone          String?

  joinedProgramAt DateTime?

  hardwareExperience HardwareExperience?

  /// The printer this participant is saving for, as an id from the catalogue in lib/config/printers.ts.
  ///
  /// It is a plain string rather than a relation or an enum because the catalogue is priced from a budget spreadsheet and is expected to be re-priced between seasons; a machine leaving the catalogue must not fail a migration or orphan a row. Null means they have not chosen, and reads fall back to the default goal.
  ///
  /// This is economically load-bearing: it sets how many hours a design week has to bank, and so what every design approval mints into the printer fund. See lib/hours.ts.
  printerGoalId String?

  /// How far through the first checkpoint this participant has got.
  ///
  /// Stores the furthest step REACHED, so closing the tab and coming back resumes rather than restarts. The step list itself lives in lib/config/onboarding.ts rather than in an enum here: the comp has already renumbered this flow once (a 5-step version survives on the older Figma page), and re-ordering copy should not need a migration.
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  /// What this participant is here for. Null means they have not answered yet.
  ///
  /// Read by the platform to hold the mandatory goal prompt open after the first checkpoint, and by staff to know how many printers the season is funding against. It is deliberately separate from the ceremony state in localStorage: that is per-browser and replays on a new laptop, while this is a fact about the person, so it has to travel with the account.
  ///
  /// Changing it never rewrites `printerGoalId`. A participant who switched off the printer branch and back on again gets their machine back rather than the default, and nothing that was already banked was ever paced against the wrong target.
  participantGoal ParticipantGoal?

  /// The tracking tutorial is the one step the comp marks dismissible - "option in corner to dismiss if you've journaled before". Recorded separately from the step counter so we can tell "read it" from "skipped it" when deciding whether to show journal hints later.
  trackingTutorialDismissedAt DateTime?

  /// Journalling streak, in days.
  ///
  /// Denormalised rather than derived: the dashboard and every feed row show it, and deriving it means a GROUP BY over the whole session table per render. It is recomputed from WorkSession.effectiveDate whenever a session is written, so the table stays the source of truth and this is a cache that can be rebuilt.
  currentStreak  Int     @default(0)
  longestStreak  Int     @default(0)
  /// YYYY-MM-DD in the program timezone of the last day that counted.
  lastStreakDate String?

  // ─── Analytics time markers ────────────────────────────────────────────────
  // When each step of the funnel first happened for this person, kept on the row so a per-user export (Loops, Airtable) is one read. Signing up is `createdAt` and onboarding is `onboardingCompletedAt`; these are the rest. Each "first" is written once and never moved; "last" ones move forward. See lib/analytics.ts, which is the only writer.
  firstProjectAt           DateTime?
  firstReelAt              DateTime?
  firstSubmissionAt        DateTime?
  lastSubmissionAt         DateTime?
  /// When the repo file checks first passed for this person (a preflight whose `canSubmit` came back true). Set once, never moved - see lib/analytics.ts.
  firstChecksPassedAt      DateTime?
  /// The last sign-in - a new session, not a page view.
  lastLoginAt              DateTime?
  /// The last page view, to within a few minutes (writes are throttled).
  lastActiveAt             DateTime?
  /// Distinct program-timezone days with a time entry over 15 minutes; the count of UserDay.
  activeDays               Int       @default(0)
  /// While now() is before this, the global submission gate does not apply to any of this user's phases. Stasis added per-user and per-project override columns after doing manual database surgery for every extension request.
  submissionExtensionUntil DateTime?

  fraudFlagged Boolean @default(false)

  /// The region whose prices the shop shows this participant. Null is base pricing; a region deactivated after being picked reads as base too.
  shopRegionId String?
  shopRegion   ShopRegion? @relation(fields: [shopRegionId], references: [id], onDelete: SetNull)

  utmSource  String?
  signupPage String?

  sessions       Session[]
  accounts       Account[]
  activityDays   UserDay[]
  activityWeeks  UserWeek[]
  roles          UserRole[]
  themeProjects  ThemeProject[]
  posts          Post[]
  publicReels    PublicReel[]
  postViews      PostView[]
  uploadHandoffs UploadHandoff[]
  postLikes      PostLike[]
  postComments   PostComment[]
  ledgerEntries  LedgerEntry[]
  shopOrders     ShopOrder[]
  shopOrderNotes ShopOrderNote[]    @relation("ShopOrderNoteAuthor")
  printerAward   PrinterAward?
  reviewsGiven   SubmissionReview[] @relation("SubmissionReviewer")
  reviewClaims   ReviewClaim[]      @relation("ReviewClaimant")
  reviewDisputes ReviewDispute[]    @relation("ReviewDisputeAuthor")
  reportsMade    ContentReport[]    @relation("ReportReporter")
  reportsAgainst ContentReport[]    @relation("ReportSubject")
  hcbGrantTopUps HcbGrantTopUp[]    @relation("HcbGrantTopUpUser")
  syncRunLogs    SyncRunLog[]       @relation("SyncRunActor")

  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// Matches what better-auth actually queries. Without it a retried OAuth callback can create two rows for the same upstream identity, and "find this user's HCA account" becomes nondeterministic about which refresh token it picks up.
  ///
  /// This used to be `@@unique([issuer, accountId])` with a required `issuer` column, on the belief that better-auth >= 1.7 keys accounts on the issuer. It does not: `findAccountOwnerByKey` in 1.7.5 takes `{ providerId, accountId }`, and neither better-auth nor @better-auth/core writes an `issuer` field at all. A NOT NULL column nothing populates made prisma.account.create() fail on every sign-in, which better-auth reports as the far less helpful `?error=unable_to_create_user`.
  ///
  /// Do not reinstate `issuer` without checking that the installed version writes it - and note that making it merely optional would be worse than useless here, because Postgres treats NULLs as distinct and this constraint would stop preventing anything.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  grantedAt DateTime @default(now())
  grantedBy String?

  @@unique([userId, role])
  @@index([userId])
  @@map("user_role")
}

// ─── Program work ────────────────────────────────────────────────────────────

/// The durable unit of participation: one row per (user, season theme), plus one for each warm-up project. Five season rows per participant at most.
///
/// Deliberately not keyed on week. Weeks are derived from ProgramSettings.eventStartDate and are advisory, so someone doing the week-3 theme in week 5 lands on the same row they would have in week 3.
model ThemeProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme  Theme

  title         String  @default("")
  description   String?
  /// R2 object key, not a URL. URLs are minted at read time so the bucket or CDN can move without rewriting every row.
  coverImageKey String?
  githubRepo    String?
  /// Links to design artifacts (EasyEDA share, Onshape doc, ...). Json because nothing queries into it.
  artifactLinks Json?

  // ─── GitHub repo sync ──────────────────────────────────────────────────────
  // A maker may mirror their devlogs and parts list into their own repo, so the work is readable without an account here. Off by default and opt-in per project: writing to someone's repository is a privilege that is asked for, never assumed.
  //
  // These are plain columns rather than a settings row because they are one project's, read whenever its page is, and never queried across projects.
  /// Whether the after-write job mirrors this project into its repo.
  repoSyncEnabled  Boolean   @default(false)
  /// Which repo the sync targets, pinned when it is switched on. Null means it follows `githubRepo`, which is the maker's choice while they are still deciding; a pin means a later edit to the link does not silently move where the next write lands (the setup flow pins it).
  repoSyncRepo     String?
  /// Program-timezone date, YYYY-MM-DD, of the last successful sync. For the "last synced" line; the per-run history is in `repo_sync_run`.
  repoSyncedAt     DateTime?
  /// Why the last attempt failed, cleared by a success. Surfaced on the project page so a maker sees a broken sync rather than finding out weeks later.
  repoSyncError    String?
  /// A sync asked for while one was already running. Picked up when the current one finishes, so a burst of edits becomes two writes rather than one per edit.
  repoSyncQueuedAt DateTime?

  // DESIGN phase
  designStatus         PhaseStatus @default(draft)
  designReviewComments String?
  designReviewedAt     DateTime?
  designReviewedById   String?

  // BUILD phase
  buildStatus         PhaseStatus @default(draft)
  buildReviewComments String?
  buildReviewedAt     DateTime?
  buildReviewedById   String?

  /// Funding tier 1-3, assigned by a reviewer at DESIGN approval. The tier's dollars are parts money, so it has to be settled before the build starts.
  tier           Int?
  /// The grant emitted to the YSWS payout pipeline, in whole USD. Written when the design phase is approved and never recomputed on read: the tier table can change mid-program, and this is the number someone was actually paid.
  grantUsd       Int?
  grantEmittedAt DateTime?

  /// Authoritative approved hours for the BUILD phase, frozen at approval. Null means "not finalized yet, compute live". Freezing matters because a participant can keep adding sessions after approval; without this their credit balance would quietly grow.
  approvedHours         Float?
  approvedHoursAt       DateTime?
  /// Authoritative approved hours for the DESIGN phase, frozen at design approval - the counterpart of `approvedHours` above, which is the build's. Design hours mint coins now (they did not in the first version of this schema), so they need the same protection against a participant adding sessions after approval and quietly growing their balance.
  designApprovedHours   Float?
  designApprovedHoursAt DateTime?

  /// Coins minted from this project, frozen alongside the hours that produced them so the ledger and the UI can never disagree about what was paid.
  ///
  /// Three fields rather than a banked/spendable pair because they have three different sources and each is reconciled against its own LedgerKind: the design's forced savings, the design's overtime, and the build's hours. Collapsing them would make an un-approval of one phase have to work out which part of a combined number belonged to the other.
  designBankedCoins    Int?
  designSpendableCoins Int?
  /// The spendable half of the build's payout only. The banked half lives in the ledger as BUILD_BANKED_HOURS and is deliberately not duplicated here, so this field is not a reconcile target for the build's two kinds.
  buildCoins           Int?

  /// Reserved for the receipts flow, which is **not shipped**: nothing writes this today. The intent was dollars of the grant the participant did not spend on parts, entered from their receipts and converted 1:1 into spendable coins through `LedgerKind.BOM_SAVINGS` / `PARTS_TOP_UP`. Building it is a product decision (who enters the receipts, when it pays) and a launch feature list item of its own.
  bomSavingsUsd Int?

  /// Tax and shipping for the whole parts order, as one total: a cart charges them once for the order rather than per part. Null until entered, and read as zero. Part of the BOM, so it locks with it.
  bomTaxShippingUsd Float?

  /// The tier the PARTICIPANT asked for, set during onboarding and editable until the design is submitted.
  ///
  /// Deliberately not `tier`: that one is the reviewer's decision and is what the grant is paid against, and a field a participant can edit must never be the field that decides money. This is a stated preference the reviewer sees - the comp is explicit that the choice "can be changed later".
  requestedTier Int?

  /// Set when the participant took one of the suggested starter projects instead of describing their own. Per the comp, that locks the request to Tier 1: the starter builds are scoped to be Tier 1 work, so letting someone pick one and then request Tier 3 would be asking a reviewer to turn down a number the app itself offered them.
  starterProjectId String?

  /// Which single phase a warm-up project is handed in as, chosen when it is made: DESIGN asks for parts funding, BUILD shows a finished build. A warm-up is one submission, never design-then-build. Null on every season project, and on warm-ups imported from Airtable, whose phase is whichever one the import put in review.
  warmupPhase Phase?

  /// Per-project deadline override, layered on top of the per-user one. Either being in the future opens the gate.
  submissionExtensionUntil DateTime?

  /// When the participant actually started it: first given a description and a tier. The row itself is made at sign-up, already titled with its theme (all five exist from the start), so neither `createdAt` nor a title says when a project began. See lib/analytics.ts (markProjectCreated).
  namedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workSessions   WorkSession[]
  hackatimeLinks HackatimeLink[]
  submissions    PhaseSubmission[]
  ledgerEntries  LedgerEntry[]
  posts          Post[]
  bomItems       BomItem[]
  publicReels    PublicReel[]
  hcbGrantTopUps HcbGrantTopUp[]
  repoSyncRuns   RepoSyncRun[]
  reports        ContentReport[]

  /// One season project per season theme per person. This makes "five themed projects" a schema invariant rather than a convention, which is what lets printer qualification be a count of five approved themes instead of a rule someone can game by creating three PCB projects.
  ///
  /// Warm-up rows are exempt: every imported Airtable row lands on `Theme.WARMUP`, and a maker may have handed the warm-up form in more than once, so those rows must not collide with each other. Nothing about the five season slots changes - the predicate only filters the warm-up rows out of this index.
  ///
  /// Deleted rows are exempt too: a maker who deletes a season project frees its slot, and opening that week's "create a project" node makes a new one. Live rows still hold one per theme.
  @@unique([userId, theme], where: raw("theme <> 'WARMUP' AND \"deletedAt\" IS NULL"))
  @@index([userId])
  @@index([designStatus])
  @@index([buildStatus])
  @@map("theme_project")
}

/// One line of a project's bill of materials, as the maker wrote it.
///
/// This is the parts list the tier's funding is asked against, so it is the maker's own claim: nothing here is priced or checked by the app, and a reviewer reads it next to the cart screenshot handed in with the design. Editable until the design week is approved, then frozen with the grant.
model BomItem {
  id             String       @id @default(cuid())
  themeProjectId String
  themeProject   ThemeProject @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)

  name        String
  /// What it is for on this board - "USB-C power in", not the part number.
  purpose     String?
  quantity    Int     @default(1)
  unitCostUsd Float   @default(0)
  vendor      String?
  link        String?
  /// The maker's order. New lines go to the end.
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([themeProjectId, sortOrder])
  @@map("bom_item")
}

/// One attempt to mirror a project into its GitHub repo: what was written, or why it was not.
///
/// Kept as rows rather than only on the project so a maker can see the history ("synced 12 times, last one failed") and staff can tell a repo-wide outage from one person's revoked token. The project's own columns carry only the latest state, which is what its page renders; this is the trail behind it.
model RepoSyncRun {
  id             String       @id @default(cuid())
  themeProjectId String
  themeProject   ThemeProject @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)

  /// `owner/repo` as it was when the run happened, so a later edit to the link does not rewrite history.
  repo String

  /// Files written, as `{ path, sha, bytes }`. Json because nothing queries into it; it exists for the "what did this run do" question.
  files Json?

  /// Null while a run is in flight, and on success. Non-null is the failure.
  error      String?
  /// Whether a person pressed "Sync now" rather than the after-write job.
  manual     Boolean   @default(false)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([themeProjectId, startedAt(sort: Desc)])
  @@map("repo_sync_run")
}

/// One row per person per day they logged a time entry over 15 minutes, in the program timezone. DAU for a day is the count of its rows; retention is a join over them. Rebuilt from WorkSession, never written directly.
model UserDay {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD in the program timezone.
  day         String
  /// When that day's first qualifying entry was created.
  firstSeenAt DateTime @default(now())

  @@id([userId, day])
  @@index([day])
  @@map("user_day")
}

/// One row per person per program week they logged hours in: the week's total, and when each milestone was first crossed. A milestone keeps its time once set, so an edit that drops the total below it later does not erase the fact that it was reached.
model UserWeek {
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  week         Int
  /// Journal hours claimed in the week, from WorkSession.weekNumber.
  hours        Float     @default(0)
  reached1hAt  DateTime?
  reached5hAt  DateTime?
  reached10hAt DateTime?
  reached20hAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@id([userId, week])
  @@index([week])
  @@map("user_week")
}

model WorkSession {
  id             String       @id @default(cuid())
  themeProjectId String
  themeProject   ThemeProject @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)
  /// Which phase's hours bucket this feeds. A design session never contributes to build hours.
  phase          Phase

  title   String
  content String? @db.Text

  hoursClaimed  Float
  /// What a reviewer accepted. Null means not individually reviewed; the hours rollup falls back to hoursClaimed.
  hoursApproved Float?
  hoursSource   HoursSource @default(MANUAL)

  /// YYYY-MM-DD in the program timezone, stamped at creation. Stasis added the equivalent column mid-event and every pre-existing row is null forever.
  effectiveDate String?
  /// Program week at creation time, frozen. Cheap week-bucketed analytics without recomputing date maths across the table.
  weekNumber    Int?

  reviewComments String?
  reviewedAt     DateTime?
  reviewedById   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  media      SessionMedia[]
  timelapses SessionTimelapse[]
  reports    ContentReport[]

  @@index([themeProjectId, phase])
  @@index([themeProjectId, createdAt])
  @@index([effectiveDate])
  @@map("work_session")
}

model SessionMedia {
  id            String      @id @default(cuid())
  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  type          MediaType
  objectKey     String
  contentType   String?
  byteSize      Int?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([workSessionId])
  @@map("session_media")
}

/// Timelapse video attached to a session.
///
/// This is evidence, not a third hours bucket. Its duration is never added to any total; it is divided by the claimed time to give the reviewer a coverage ratio, so a session claiming six hours with five hours of timelapse reads very differently from one with none.
model SessionTimelapse {
  id            String      @id @default(cuid())
  workSessionId String
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  /// "lapse" for everything recorded since timelapses moved to Lapse; "r2" for the uploads that came before.
  provider       String  @default("r2")
  objectKey      String?
  /// The timelapse's id on its provider. For Lapse, what the session was checked against at attach time: owned by the claimant, and published.
  externalId     String?
  playbackUrl    String?
  thumbnailUrl   String?
  /// Wall-clock seconds the timelapse REPRESENTS. A 30x timelapse of two hours is 7200 here, not 240.
  coveredSeconds Int?
  /// The video's own runtime, kept separate so a mistyped speedup factor is diagnosable instead of silently inflating coverage.
  runtimeSeconds Int?
  speedupFactor  Float?

  /// When the RECORDING started, from Lapse's createdAt (epoch ms, stored as a timestamp). With coveredSeconds this is the wall-clock window the footage covers, which is what gets intersected with Hackatime's spans to find time both tools counted. Null on rows written before this existed - a backfill fills what Lapse still answers for, and the rest stay undeduplicated rather than being guessed at.
  recordedAt       DateTime?
  /// The Hackatime project Lapse had synced when this was recorded. Kept as the corroborating fact Lapse reports; the subtraction itself uses real Hackatime spans, so a mismatch here cannot invent an overlap on its own.
  hackatimeProject String?

  createdAt DateTime @default(now())

  @@index([workSessionId])
  @@index([provider, externalId])
  @@map("session_timelapse")
}

/// A linked Hackatime project, scoped to one themed project and phase. Firmware for the music week project is a different link from firmware for the Breadboard Computer, so this is per-project rather than per-user.
model HackatimeLink {
  id               String       @id @default(cuid())
  themeProjectId   String
  themeProject     ThemeProject @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)
  hackatimeProject String
  phase            Phase        @default(BUILD)

  /// Reviewer override. Non-null replaces the live value permanently.
  hoursApproved Float?
  reviewedAt    DateTime?
  reviewedById  String?

  /// Last successful fetch. Stasis's Hackatime client returns 0 on any error including a timeout, and that zero flows straight into the hours number on the grant row with no trace. Caching the last good value and recording the error makes the degraded path both closer to correct and visible.
  cachedSeconds  Int?
  cachedAt       DateTime?
  lastFetchError String?

  /// The project's tracked INTERVALS for the same period, as `{ start: <epoch seconds>, end: <epoch seconds> }[]`. The total above cannot say when the time was logged, so it cannot be compared against a timelapse's recording window; these can. Null until the first span fetch, and kept as the last good value on failure for the same reason cachedSeconds is.
  cachedSpans     Json?
  spansFetchedAt  DateTime?
  spansFetchError String?

  createdAt DateTime @default(now())

  /// One tracked project backs one phase: `fetchProjectSeconds` returns the project's whole total, not a range, so a second link in the other phase would count the same time twice. Moving a link between phases is deleting it and adding it again.
  @@unique([themeProjectId, hackatimeProject])
  @@index([themeProjectId, phase])
  @@map("hackatime_link")
}

// ─── Review ──────────────────────────────────────────────────────────────────

/// One row per submit attempt for a (ThemeProject, Phase). Resubmitting after an update_requested creates a new row; the old one stays as history.
model PhaseSubmission {
  id             String       @id @default(cuid())
  themeProjectId String
  themeProject   ThemeProject @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)
  phase          Phase

  notes String? @db.Text

  /// R2 object keys for evidence handed in with the submission - the cart screenshot a design week asks for, and anything else the form collects.
  ///
  /// Keys, not URLs: they are minted at read time so the bucket or the CDN in front of it can move without rewriting a row. An array rather than a child table because nothing queries into it; the reviewer reads the whole list or none of it.
  attachmentKeys String[] @default([])

  /// Frozen at submit time. Together with the theme's scheduled week this answers "did they do week 3's theme in week 5". Analytics only - no gate reads these.
  submittedInWeek Int?
  scheduledWeek   Int?
  onTime          Boolean @default(false)

  /// The parts list ran past what the tier being asked for funds, and the maker ticked the box saying they know they will only be funded up to the tier and will cover the rest themselves.
  ///
  /// A design submission only, and only when the cart was actually over the margin - below that a slightly-over cart has always submitted as itself. Recorded here rather than left to the review conversation because it is a statement made about a specific cart at a specific moment: the cart stays editable until design approval, and the tier table is expected to move mid-program, so neither the number they agreed to nor the cap they agreed under can be reconstructed from the project row afterwards.
  partialFundingAccepted Boolean @default(false)
  /// The maker ticked the box saying they want no parts funding for this project – scrounged parts, their own stock, or a sponsor. A design submission only: a build carries no parts money, so there is nothing to decline there. Recorded for the reviewer rather than inferred from an empty parts list, because a declined list can still be full.
  fundingDeclined Boolean @default(false)
  /// The cart total shown when they ticked the box, and the tier funding they were told covers it. Null on every submission that did not need the agreement.
  requestedBomUsd Float?
  fundingCapUsd   Int?

  /// Set by an advisory first-pass review. Unused while v1 runs single-pass.
  preReviewed   Boolean   @default(false)
  preReviewedAt DateTime?

  /// The Ari submission this hand-in was sent as (`ari.ships.create`), and the last state Ari reported for it. Null on `ariSubmissionId` means the send has not succeeded yet, which is what the retry job looks for.
  ///
  /// `external_id` is derived as `<themeProjectId>:<design|build>`, so these are recovery breadcrumbs rather than a lookup key - a submission is found by (project, phase).
  ariSubmissionId String?
  ariStatus       String?
  ariDecision     String?
  ariSyncedAt     DateTime?

  /// Set when a send failed for a reason a retry cannot fix - an unparseable repo link, a missing title, an account with no Slack id. Cleared by a later success.
  ///
  /// Two jobs. The transition from null to non-null is the single moment the maker is told: the retry job replays every unsent hand-in hourly, so without a mark to read it would send the same notice on every attempt. And the value is what the project page shows in place of a bare "in review", so a maker who never opened the message still finds out.
  ariShipError String?

  /// Non-null means this submission is resolved and immutable.
  resolvedAt     DateTime?
  resolvedResult ReviewResult?

  createdAt DateTime @default(now())

  reviews SubmissionReview[]
  claim   ReviewClaim?
  dispute ReviewDispute?

  @@index([themeProjectId])
  @@index([themeProjectId, phase, createdAt(sort: Desc)])
  /// The review queue's hot path: unresolved submissions, oldest first.
  @@index([resolvedAt, createdAt])
  @@map("phase_submission")
}

/// Exclusive, expiring lock held while a reviewer works on a submission.
///
/// submissionId is unique, so claiming is a single insert that either succeeds or throws a unique violation. Never implement this as read-then-write.
model ReviewClaim {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   PhaseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User            @relation("ReviewClaimant", fields: [reviewerId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime        @default(now())

  @@index([reviewerId])
  @@index([expiresAt])
  @@map("review_claim")
}

model SubmissionReview {
  id           String          @id @default(cuid())
  submissionId String
  submission   PhaseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// Null when the decision came from Ari rather than a Half Life user; the audit row carries the platform reviewer's identity instead.
  reviewerId   String?
  reviewer     User?           @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  /// Who actually decided, as an email. Set for every decision – a console reviewer's own address, or the Ari reviewer's address from the webhook – so leaderboards and histories can credit the person even when they hold no Half Life account and `reviewerId` is null. Backfilled from the audit rows for decisions that predate the column.
  reviewerEmail String?
  /// The reviewer's name as reported alongside the email, for display when no user row matches it. Best-effort: present on Ari decisions, which carry no account to join against.
  reviewerName String?

  pass   ReviewPass   @default(FINAL)
  result ReviewResult

  /// Shown to the submitter.
  feedback String  @db.Text
  /// Internal justification, never shown to the submitter.
  reason   String? @db.Text

  /// Set when a later action supersedes this review (an un-approval). Keeps the history intact without letting a stale row drive computations.
  invalidated   Boolean   @default(false)
  invalidatedAt DateTime?

  // What the reviewer explicitly overrode; null means they took the default.
  hoursOverride    Float?
  tierOverride     Int?
  grantUsdOverride Int?

  /// Snapshot of everything the reviewer was looking at, written unconditionally. The tier table is expected to change mid-program, so without frozenGrantUsd there is no way to reconstruct why someone was paid what they were paid.
  frozenJournalHours     Float?
  frozenHackatimeHours   Float?
  frozenTimelapseSeconds Int?
  frozenEntryCount       Int?
  frozenApprovedHours    Float?
  frozenTier             Int?
  frozenGrantUsd         Int?
  frozenBankedCoins      Int?
  frozenSpendableCoins   Int?
  /// The hour split as it stood at review time. `frozenTier` alone is not enough to reconstruct a payout once the tier table has been edited.
  ///
  /// `frozenFundingHours` comes from the tier. `frozenBankHours` comes from the PRINTER the participant was saving for, not from the tier - banking is paced by the machine - so `frozenPrinterGoalId` records which one, and the two together are what make a payout reconstructable after either table has moved under it.
  frozenFundingHours     Float?
  frozenBankHours        Float?
  frozenPrinterGoalId    String?

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([reviewerId, createdAt])
  @@map("submission_review")
}

/// A maker's disagreement with a decided submission.
///
/// It deliberately changes no state: a returned or rejected phase stays that way, and no button silently overrides a reviewer. What it does is put the submission in front of staff for a second look, with the maker's own words on it. One per submission (`submissionId` is unique), so the queue cannot be flooded by the same decision.
model ReviewDispute {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   PhaseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("ReviewDisputeAuthor", fields: [userId], references: [id], onDelete: Cascade)

  note String @db.Text

  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?   @db.Text

  @@index([resolvedAt])
  @@map("review_dispute")
}

/// A participant flagging user-generated content for staff: a reel, a reel comment, a project, a user, or a devlog entry.
///
/// It changes no state: like ReviewDispute, it records words and puts them in front of staff. Taking the thing down stays a separate admin action (the existing hide routes), so a report is never a silent takedown.
model ContentReport {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  target  ReportTarget
  reason  ReportReason
  /// Optional context in the reporter's own words.
  details String?      @db.Text

  /// Exactly one of these is set, matching `target` - checked in the route.
  postId         String?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        PostComment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  themeProjectId String?
  themeProject   ThemeProject? @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)
  targetUserId   String?
  targetUser     User?         @relation("ReportSubject", fields: [targetUserId], references: [id], onDelete: Cascade)
  workSessionId  String?
  workSession    WorkSession?  @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  status       ReportStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  

  @@index([status, createdAt])
  @@index([reporterId])
  @@map("content_report")
}

/// One HCB card-grant top-up Half Life has sent.
///
/// Keyed on (user, project, phase) so a grant is paid once: a double-click or a retried request cannot pay twice. The row is written before HCB is called and marked `sentAt` after, so a call that failed is recorded (and can be retried) while one that succeeded short-circuits the next attempt.
model HcbGrantTopUp {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation("HcbGrantTopUpUser", fields: [userId], references: [id], onDelete: Cascade)
  themeProjectId String
  themeProject   ThemeProject @relation(fields: [themeProjectId], references: [id], onDelete: Cascade)
  phase          Phase

  /// The grant's HCB hashid, as parsed from the link an admin pasted.
  grantHashid   String
  amountCents   Int
  /// HCB's transaction id once it succeeded.
  transactionId String?
  sentAt        DateTime?
  /// Why the last attempt failed, cleared when it is retried.
  error         String?

  createdAt   DateTime @default(now())
  createdById String?

  @@unique([userId, themeProjectId, phase])
  @@map("hcb_grant_topup")
}

/// One row per accepted Ari webhook, for idempotency.
///
/// Ari redelivers an event (same `delivery_id`) until it gets a 2xx, so the work must be safe to repeat and the delivery must only be recorded once it has actually finished - see `applyAriWebhook` in lib/ari.ts. A manual resend gets a new delivery id and is meant to run again.
model AriWebhookDelivery {
  id              String   @id @default(cuid())
  deliveryId      String   @unique
  event           String
  ariSubmissionId String?
  externalId      String?
  receivedAt      DateTime @default(now())

  /// Set on a decision whose state said "not yet" - a build approval that arrived before its design. `payload` holds the whole event so the retry job can apply it once the design lands; `appliedAt` marks it done. Ordinary deliveries have both null.
  appliedAt DateTime?
  payload   Json?

  @@index([receivedAt])
  @@index([appliedAt])
  @@map("ari_webhook_delivery")
}

// ─── Feed ────────────────────────────────────────────────────────────────────

/// A short video made for the Doomscroller.
///
/// Deliberately NOT a WorkSession or a SessionMedia row. A journal entry is evidence a reviewer reads to decide what someone is paid; a post is something a participant makes to be watched. Sharing one table would mean every feed query has to exclude review evidence and every hours rollup has to exclude posts - two filters that only have to be forgotten once for either private journal media to appear in a public feed, or a post to inflate someone's hours.
///
/// Like SessionMedia, this stores the R2 object key and never a URL: the public URL is minted at read time, so moving buckets or putting a CDN in front does not mean rewriting every row.
model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional: a post can be about a project, or just about the week.
  themeProjectId String?
  themeProject   ThemeProject? @relation(fields: [themeProjectId], references: [id], onDelete: SetNull)

  kind    PostKind @default(FREEFORM)
  caption String   @db.Text

  /// The checkpoint on the trail this reel was posted for, e.g. "w3-reel-2".
  ///
  /// The trail asks for a reel at fixed points - the idea at the start of a design week, then one every ten hours logged - and those nodes have to be told apart. `kind` cannot do it: the 10h and the 20h reel are both PROGRESS, so counting them would mark the 20h node done the moment the 10h one was posted.
  ///
  /// Null for anything posted outside the trail, which is most of the feed. Not unique: re-posting a reel for a node is allowed, and the newest one wins when the trail reads it back.
  checkpointKey String?

  /// R2 keys, namespaced by user id so abuse is traceable and orphans are findable.
  objectKey    String
  thumbnailKey String?

  contentType     String?
  byteSize        Int?
  durationSeconds Int?
  width           Int?
  height          Int?

  status      PostStatus @default(PROCESSING)
  publishedAt DateTime?

  /// Denormalised counts. The rows stay as the audit trail; these are what the feed renders, because a feed page that aggregated three child tables per card would do it once per card.
  ///
  /// Every writer updates the row and the count in one transaction, so they cannot drift apart without a bug - and if one ever does, the rows are still the truth and these can be rebuilt from them.
  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)

  /// Non-null pins this to the top of the feed. Only ANNOUNCEMENT posts get this, and only staff can create those.
  pinnedAt DateTime?

  /// Moderation. Set together, and never by anything but an admin action.
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason String?

  /// Program week at creation, frozen - same reasoning as WorkSession.
  weekNumber Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  views       PostView[]
  likes       PostLike[]
  comments    PostComment[]
  publicReels PublicReel[]
  reports     ContentReport[]

  /// The feed's hot path: published posts, newest first.
  @@index([status, publishedAt(sort: Desc)])
  /// "Has this project posted its idea reel yet" - the checkpoint lookup.
  @@index([themeProjectId, kind])
  /// The trail's lookup: which nodes this participant has posted a reel for.
  @@index([userId, checkpointKey])
  @@index([userId, createdAt])
  @@index([themeProjectId])
  @@map("post")
}

/// One row per liker per post.
///
/// Like PostView, the unique key is the mechanism rather than a nicety: a second like is a failed insert, so a like count cannot be inflated by clicking twice or by a retried request.
model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_like")
}

/// A comment on a reel.
///
/// Soft-deleted and separately hideable: the audience is 13-18, so a moderator needs to be able to take something out of the feed without destroying the record of what was said.
model PostComment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String @db.Text

  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reports ContentReport[]

  @@index([postId, createdAt])
  @@index([userId])
  @@map("post_comment")
}

/// One row per viewer per post.
///
/// Exists so "went viral" is a number nobody can inflate by refreshing, which matters because the program pays out prizes on virality. The unique key is the whole mechanism: a repeat view is a failed insert, not an increment.
model PostView {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_view")
}

// ─── Economy ─────────────────────────────────────────────────────────────────

/// Append-only credit ledger. Rows are never updated or deleted.
///
/// Invariant: for a given (userId, themeProjectId, kind) the SUM of amounts equals the current target for that grant. Re-review appends a delta row rather than a second full grant, which is what makes approving the same project five times converge instead of compound. See lib/currency.ts.
model LedgerEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null for account-level entries (admin adjustment, reviewer pay, shop).
  themeProjectId String?
  themeProject   ThemeProject? @relation(fields: [themeProjectId], references: [id], onDelete: SetNull)

  kind   LedgerKind
  /// Which pot this moves. A purchase that draws on both writes one row per bucket, which is why the shopOrder uniqueness below includes it.
  bucket CoinBucket @default(SPENDABLE)
  /// Signed. Positive credits, negative debits.
  amount Int

  note String?

  /// Captured at write time as an audit aid only. The authoritative balance is always SUM(amount) - if these ever disagree, a write escaped the transaction wrapper and you want to find out.
  balanceBefore Int
  balanceAfter  Int

  shopOrderId String?
  shopOrder   ShopOrder? @relation(fields: [shopOrderId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())

  /// At most one purchase row and one refund row per order PER BUCKET. Postgres treats nulls as distinct, so account-level rows are unaffected. This is what stops a double-submitted purchase form from charging twice.
  ///
  /// `bucket` is part of the key because buying a printer can legitimately write two SHOP_PURCHASE rows for one order - one draining the printer fund, one taking the remainder from spendable coins. Without it the second insert violates the constraint and the whole purchase rolls back.
  @@unique([shopOrderId, kind, bucket])
  @@index([userId, createdAt])
  /// The reconcile aggregate must be a single index scan.
  @@index([userId, themeProjectId, kind])
  /// Both balances are a SUM over this.
  @@index([userId, bucket])
  @@map("ledger_entry")
}

model ShopItem {
  /// Hand-assigned slug, not a cuid: it appears in config and analytics and has to survive a rename.
  id          String           @id
  name        String
  description String
  imageUrl    String?
  category    ShopItemCategory @default(PRINTER_UPGRADE)

  priceCredits Int
  /// What Hack Club pays for one, tax and shipping included. Null until an admin sets it.
  costUsd      Float?
  /// 0 means unlimited.
  maxPerUser   Int    @default(1)
  /// Null means unlimited.
  stock        Int?

  /// Most items bolt onto the printer, so buying one without qualifying for the printer is meaningless.
  requiresPrinterQualified Boolean @default(true)

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       ShopOrder[]
  /// Per-region coin prices. An item with no row for a region sells there at `priceCredits`; a row overrides it. Orders snapshot the price they were charged, so changing or removing a row never rewrites history.
  regionPrices ShopItemRegionPrice[]

  @@index([active, sortOrder])
  @@map("shop_item")
}

/// A sales region staff can price the shop for separately.
///
/// Participants pick theirs on the shop page; it is stored on the user so the price they see is the price the server charges. Deactivating a region falls everyone on it back to base pricing - rows are kept, not deleted, so re-activating restores the overrides and no history is lost.
model ShopRegion {
  /// Hand-assigned slug, like a shop item id: it appears in analytics and has to survive a rename of the display name.
  id     String  @id
  name   String
  active Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  prices ShopItemRegionPrice[]

  @@index([active, sortOrder])
  @@map("shop_region")
}

/// One region's coin price for one shop item. Absent means base pricing.
model ShopItemRegionPrice {
  id String @id @default(cuid())

  shopItemId String
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  regionId String
  region   ShopRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  priceCredits Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopItemId, regionId])
  @@map("shop_item_region_price")
}

model ShopOrder {
  id          String @id @default(cuid())
  orderNumber Int    @unique @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopItemId String
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  quantity         Int
  unitCredits      Int
  totalCredits     Int
  /// The catalogue changes; order history must not.
  itemNameSnapshot String
  /// ShopItem.costUsd at order time. Null when the item had no cost set yet.
  unitCostUsd      Float?

  status          ShopOrderStatus @default(PENDING)
  holdReason      String?
  rejectionReason String?

  /// Encrypted JSON snapshot of the address at order time.
  encryptedAddress String @default("")
  encryptedPhone   String @default("")

  trackingNumber  String?
  trackingCarrier String?

  fulfillmentMethod    ShopFulfillmentMethod?
  fulfillmentStage     ShopFulfillmentStage   @default(UNFULFILLED)
  fulfillmentUpdatedAt DateTime?

  placedAt    DateTime  @default(now())
  heldAt      DateTime?
  rejectedAt  DateTime?
  fulfilledAt DateTime?
  lastActorId String?

  /// Client-supplied, one per purchase intent. A retried request with the same key resolves to the order it already made instead of charging again.
  idempotencyKey String?

  notes         ShopOrderNote[]
  ledgerEntries LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status, placedAt])
  @@index([shopItemId])
  @@map("shop_order")
}

model ShopOrderNote {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ShopOrderNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String    @db.Text
  createdAt DateTime  @default(now())

  @@index([orderId])
  @@map("shop_order_note")
}

/// The 3D printer prize.
///
/// This is a fulfilment record, not an eligibility record: eligibility is always recomputed from ThemeProject state. Keeping them separate means an un-approval after the fact surfaces as a mismatch an admin resolves, rather than silently revoking a printer that is already in a box.
model PrinterAward {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  qualifiedAt        DateTime
  /// Snapshot of the five themes and their approval timestamps, so a later un-approval does not erase the evidence.
  qualifyingSnapshot Json

  status PrinterAwardStatus @default(QUALIFIED)

  encryptedAddress String    @default("")
  encryptedPhone   String    @default("")
  addressLockedAt  DateTime?

  trackingNumber  String?
  trackingCarrier String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("printer_award")
}

/// A one-shot permission to upload one video, used to hand recording off to a phone without asking anyone to log in on it.
///
/// The desktop mints one of these, renders the token as a QR code, and the phone opens it. That URL is a BEARER CREDENTIAL - whoever holds it can upload one video as the user it belongs to - so every property here is about keeping the blast radius to exactly that:
///
/// - the token is never stored, only its SHA-256, so a database leak does not hand anyone a working upload link;
/// - `usedAt` is claimed with a guarded UPDATE, so two phones racing the same QR code cannot both upload;
/// - `expiresAt` is minutes, not hours, because the code is displayed on a screen that other people can see;
/// - the upload is written under the OWNER's prefix, taken from this row and never from the request.
model UploadHandoff {
  id String @id @default(cuid())

  /// SHA-256 of the token. Unique so a lookup is one indexed read.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Set the moment a phone claims it. Non-null means spent, forever.
  usedAt    DateTime?
  /// Set when the desktop has picked the result up, so it stops polling.
  claimedAt DateTime?

  /// Populated by the phone's upload.
  objectKey   String?
  contentType String?
  byteSize    Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("upload_handoff")
}

// ─── Ops ─────────────────────────────────────────────────────────────────────

/// Singleton row of live program settings.
///
/// Deliberately not env vars. Stasis put its submission gate in SUBMISSIONS_CLOSED and lib/event.ts records the outcome verbatim: the var "was never flipped in Coolify and submissions silently stayed open for two weeks". A database row with an admin toggle and an audit trail cannot be forgotten in a dashboard. The env vars survive only as seed defaults.
model ProgramSettings {
  id String @id @default("singleton")

  /// Week 1, day 1, midnight in programTimezone. All week maths derives from it.
  eventStartDate  DateTime
  programTimezone String   @default("America/New_York")

  submissionsOpen    Boolean   @default(true)
  submissionsCloseAt DateTime?

  shopOpen      Boolean   @default(false)
  shopClosesAt  DateTime?
  /// The shop stays open this many days past a participant's last review, so credit awarded at the buzzer is actually spendable.
  shopGraceDays Int       @default(7)

  reviewClaimTtlMinutes Int @default(45)

  /// Kill switch for the outbound Airtable writer, without a redeploy.
  airtableSyncEnabled Boolean @default(true)

  /// Kill switch for the GitHub repo sync, without a redeploy - the same role `airtableSyncEnabled` plays for the other outbound writer. A maker's own per-project toggle is theirs; this is what stops every project at once if GitHub is the thing that is wrong.
  repoSyncEnabled Boolean @default(true)

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("program_settings")
}

model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  actorId        String?
  actorEmail     String?
  actorIp        String?
  actorUserAgent String?
  targetType     String?
  targetId       String?
  /// Records the before and after value of anything that changed. Knowing that something happened is much less useful six weeks later than knowing what it changed from and to.
  metadata       Json?
  createdAt      DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_log")
}

/// One row per successful sync run, so admin surfaces can show "last synced N minutes ago" and tell a cron run apart from a human pressing a button. Failures go to AuditLog, so a timestamp here always means a real round trip.
model SyncRunLog {
  id        String   @id @default(cuid())
  syncKey   String
  result    Json?
  actorId   String?
  actor     User?    @relation("SyncRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([syncKey, createdAt])
  @@map("sync_run_log")
}

/// RSVP write-behind buffer.
///
/// Airtable is the funnel's source of truth but it rate-limits and it goes down. Every RSVP is written here first and drained to Airtable by a job, so a marketing-page signup never fails because a third party is having a bad day. Stasis writes through to Airtable synchronously and only falls back to Postgres when someone flips an env var by hand.
/// "Public Reels": a Half Life reel a participant has also posted publicly - one row per link, so an Instagram post and a TikTok of the same reel are two rows. Kept so a post that goes viral can be found and paid for; the views themselves are read on the platform, not stored here.
///
/// `email` is the account's address at the moment the link was added, copied rather than joined: it is what staff reach the person by when a post takes off, and it should still say who claimed the link if the account changes.
model PublicReel {
  id       String             @id @default(cuid())
  /// The link as shared, tidied: https, lower-case host, tracking query and fragment dropped. Unique, so one public post can only ever be claimed once.
  url      String             @unique @db.Text
  platform PublicReelPlatform
  email    String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The Half Life reel it is a copy of.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  /// The project the reel belongs to, if it belongs to one.
  themeProjectId String?
  themeProject   ThemeProject? @relation(fields: [themeProjectId], references: [id], onDelete: SetNull)

  /// When the link was added here.
  postedAt DateTime @default(now())

  @@index([userId, postedAt])
  @@index([postId])
  @@index([themeProjectId])
  @@map("public_reel")
}

model RsvpBuffer {
  id    String @id @default(cuid())
  email String @unique

  firstName String?
  lastName  String?
  pronouns  String?

  ip         String?
  utmSource  String?
  signupPage String?
  referredBy String?

  finishedAccountCreation Boolean @default(false)
  userId                  String?

  syncedToAirtable Boolean   @default(false)
  syncedAt         DateTime?
  syncAttempts     Int       @default(0)
  lastSyncError    String?
  /// Set once the row exists upstream, so later updates are a patch by id rather than a formula search.
  airtableRecordId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The drain job's hot path.
  @@index([syncedToAirtable, syncAttempts, createdAt])
  @@map("rsvp_buffer")
}

/// One row per #half-life-help question the bot turned into a ticket.
///
/// The Slack-side flow is otherwise stateless - the button carries the ticket ref and a resolved tickets-channel mirror is deleted - so this is the only durable record that someone asked. It backs the "N previous tickets" note staff see on a new ticket and the daily summary's opened/closed counts.
model HelpTicket {
  id            String    @id @default(cuid())
  /// The asker's Slack user id (TicketRef.authorId), not a User row: help is open to anyone in the workspace, most of whom never sign in here.
  authorSlackId String
  /// The #half-life-help channel and the original message's ts - the ticket's Slack identity. Unique so a redelivery cannot be counted twice.
  helpChannel   String
  helpTs        String
  createdAt     DateTime  @default(now())
  /// When the ticket was resolved, from any of the three buttons; null while it is still waiting. Set once per resolution – reopening clears it so a second resolution writes anew, which is what lets a solved-then-reopened ticket count its final close rather than its first.
  resolvedAt    DateTime?
  /// The Slack user who resolved it: the helper for either "Mark as helped" button, the asker themselves for "I'm all set". Null until resolved, and cleared on reopen like resolvedAt.
  resolvedBy    String?

  @@unique([helpChannel, helpTs])
  @@index([authorSlackId, createdAt])
  @@index([resolvedAt])
  @@map("help_ticket")
}

/// One dated thing on the programme calendar: the weekly call, a lock-in huddle, a show & tell, a soldering workshop.
///
/// A row per occurrence rather than a recurring rule, deliberately. A standing weekly call is ten rows sharing a `seriesId`, and each can then be moved, retitled or cancelled on its own - which is what actually happens, when the week one call lands on a bank holiday. A rule would turn every cancellation into a migration.
///
/// Moments are stored as instants and read in `ProgramSettings.programTimezone`, like every other deadline in the app: an event is a fact about a moment, and which wall clock shows it is a question the programme already answers once.
model ProgramEvent {
  id String @id @default(cuid())

  title       String
  colour      EventColour @default(SLATE)
  /// Optional. Long enough for an agenda, short enough to sit in a calendar card.
  description String?

  /// When it starts. The countdown in the shell header reads this column.
  startsAt DateTime
  /// When it ends, when that is known. Optional because an open call has no end - and because an end that is wrong is worse than none.
  endsAt   DateTime?

  /// A draft never reaches a participant's header or calendar. The column rather than a delete because half-announced things are real, and the week before the announcement is exactly when it is written.
  published Boolean @default(true)

  /// Shared by every occurrence created together; null for a one-off.
  seriesId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([published, startsAt])
  @@index([seriesId])
  @@map("program_event")
}
