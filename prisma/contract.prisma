// use prisma-8
// Printed from a copy of prisma/schema.prisma with the partial-index predicates and index sort directions Prisma 8 refuses removed. Field and relation names must stay in sync with the Prisma 7 schema until migrations move over.

namespace public {
  model ShopRegion {
    id        String                @id
    name      String
    active    Boolean               @default(true)
    sortOrder Int                   @default(0)
    createdAt TimestampString(3)    @default(now())
    updatedAt TimestampString(3)    @onCreate(now()) @onUpdate(now())
    prices    ShopItemRegionPrice[]
    users     User[]

    @@index([active, sortOrder], map: "shop_region_active_sortOrder_idx")
    @@map("shop_region")
  }

  model User {
    id                          String                       @id @onCreate(cuid(2))
    email                       String
    name                        String?
    displayName                 String?
    emailVerified               Boolean                      @default(false)
    image                       String?
    createdAt                   TimestampString(3)           @default(now())
    updatedAt                   TimestampString(3)           @onCreate(now()) @onUpdate(now())
    slackId                     String?
    slackDisplayName            String?
    hackatimeUserId             String?
    verificationStatus          String?
    bio                         String?
    pronouns                    String?
    timezone                    String?
    encryptedAddressStreet      String?
    encryptedAddressLine2       String?
    encryptedAddressCity        String?
    encryptedAddressState       String?
    encryptedAddressZip         String?
    encryptedAddressCountry     String?
    encryptedBirthday           String?
    encryptedPhone              String?
    joinedProgramAt             TimestampString(3)?
    hardwareExperience          pg.enum(HardwareExperience)?
    printerGoalId               String?
    onboardingStep              Int                          @default(0)
    onboardingCompletedAt       TimestampString(3)?
    participantGoal             pg.enum(ParticipantGoal)?
    trackingTutorialDismissedAt TimestampString(3)?
    currentStreak               Int                          @default(0)
    longestStreak               Int                          @default(0)
    lastStreakDate              String?
    firstProjectAt              TimestampString(3)?
    firstReelAt                 TimestampString(3)?
    firstSubmissionAt           TimestampString(3)?
    lastSubmissionAt            TimestampString(3)?
    firstChecksPassedAt         TimestampString(3)?
    lastLoginAt                 TimestampString(3)?
    lastActiveAt                TimestampString(3)?
    activeDays                  Int                          @default(0)
    submissionExtensionUntil    TimestampString(3)?
    fraudFlagged                Boolean                      @default(false)
    shopRegionId                String?
    utmSource                   String?
    signupPage                  String?
    accounts                    Account[]
    activityDays                UserDay[]
    activityWeeks               UserWeek[]
    disputeMessages             ReviewDisputeMessage[]
    hcbGrantTopUps              HcbGrantTopUp[]
    ledgerEntries               LedgerEntry[]
    postComments                PostComment[]
    postLikes                   PostLike[]
    posts                       Post[]
    postViews                   PostView[]
    printerAward                PrinterAward?
    publicReels                 PublicReel[]
    reviewClaims                ReviewClaim[]
    reviewDisputes              ReviewDispute[]
    reviewsGiven                SubmissionReview[]
    roles                       UserRole[]
    sessions                    Session[]
    shopOrderNotes              ShopOrderNote[]
    shopOrders                  ShopOrder[]
    syncRunLogs                 SyncRunLog[]
    themeProjects               ThemeProject[]
    uploadHandoffs              UploadHandoff[]
    shopRegion                  ShopRegion?                  @relation(fields: [shopRegionId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    reportsAgainst              ContentReport[]              @relation(name: "ContentReport_targetUser")
    reportsMade                 ContentReport[]              @relation(name: "ContentReport_reporter")

    @@index([email], map: "user_email_key", unique: true)
    @@index([slackId], map: "user_slackId_key", unique: true)
    @@index([hackatimeUserId], map: "user_hackatimeUserId_key", unique: true)
    @@index([createdAt], map: "user_createdAt_idx")
    @@map("user")
  }

  model Account {
    id                    String              @id
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  TimestampString(3)?
    refreshTokenExpiresAt TimestampString(3)?
    scope                 String?
    password              String?
    createdAt             TimestampString(3)  @default(now())
    updatedAt             TimestampString(3)  @onCreate(now()) @onUpdate(now())
    user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([providerId, accountId], map: "account_providerId_accountId_key", unique: true)
    @@index([userId], map: "account_userId_idx")
    @@map("account")
  }

  model AriWebhookDelivery {
    id              String              @id @onCreate(cuid(2))
    deliveryId      String
    event           String
    ariSubmissionId String?
    externalId      String?
    receivedAt      TimestampString(3)  @default(now())
    appliedAt       TimestampString(3)?
    payload         Jsonb?

    @@index([deliveryId], map: "ari_webhook_delivery_deliveryId_key", unique: true)
    @@index([receivedAt], map: "ari_webhook_delivery_receivedAt_idx")
    @@index([appliedAt], map: "ari_webhook_delivery_appliedAt_idx")
    @@map("ari_webhook_delivery")
  }

  model AuditLog {
    id             String               @id @onCreate(cuid(2))
    action         pg.enum(AuditAction)
    actorId        String?
    actorEmail     String?
    actorIp        String?
    actorUserAgent String?
    targetType     String?
    targetId       String?
    metadata       Jsonb?
    createdAt      TimestampString(3)   @default(now())

    @@index([actorId, createdAt], map: "audit_log_actorId_createdAt_idx")
    @@index([action, createdAt], map: "audit_log_action_createdAt_idx")
    @@index([targetId], map: "audit_log_targetId_idx")
    @@index([createdAt], map: "audit_log_createdAt_idx")
    @@map("audit_log")
  }

  model ThemeProject {
    id                       String               @id @onCreate(cuid(2))
    userId                   String
    theme                    pg.enum(Theme)
    title                    String               @default("")
    description              String?
    coverImageKey            String?
    githubRepo               String?
    artifactLinks            Jsonb?
    repoSyncEnabled          Boolean              @default(false)
    repoSyncRepo             String?
    repoSyncedAt             TimestampString(3)?
    repoSyncError            String?
    repoSyncQueuedAt         TimestampString(3)?
    designStatus             pg.enum(PhaseStatus) @default("draft")
    designReviewComments     String?
    designReviewedAt         TimestampString(3)?
    designReviewedById       String?
    buildStatus              pg.enum(PhaseStatus) @default("draft")
    buildReviewComments      String?
    buildReviewedAt          TimestampString(3)?
    buildReviewedById        String?
    tier                     Int?
    grantUsd                 Int?
    grantEmittedAt           TimestampString(3)?
    approvedHours            Float?
    approvedHoursAt          TimestampString(3)?
    designApprovedHours      Float?
    designApprovedHoursAt    TimestampString(3)?
    designBankedCoins        Int?
    designSpendableCoins     Int?
    buildCoins               Int?
    bomSavingsUsd            Int?
    bomTaxShippingUsd        Float?
    requestedTier            Int?
    starterProjectId         String?
    warmupPhase              pg.enum(Phase)?
    submissionExtensionUntil TimestampString(3)?
    namedAt                  TimestampString(3)?
    createdAt                TimestampString(3)   @default(now())
    updatedAt                TimestampString(3)   @onCreate(now()) @onUpdate(now())
    deletedAt                TimestampString(3)?
    deletedById              String?
    bomItems                 BomItem[]
    hackatimeLinks           HackatimeLink[]
    hcbGrantTopUps           HcbGrantTopUp[]
    ledgerEntries            LedgerEntry[]
    posts                    Post[]
    publicReels              PublicReel[]
    reports                  ContentReport[]
    repoSyncRuns             RepoSyncRun[]
    submissions              PhaseSubmission[]
    workSessions             WorkSession[]
    user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([userId, theme], map: "theme_project_userId_theme_key", unique: true, where: sql`((theme <> 'WARMUP'::"Theme") AND ("deletedAt" IS NULL))`)
    @@index([userId], map: "theme_project_userId_idx")
    @@index([designStatus], map: "theme_project_designStatus_idx")
    @@index([buildStatus], map: "theme_project_buildStatus_idx")
    @@map("theme_project")
  }

  model BomItem {
    id             String             @id @onCreate(cuid(2))
    themeProjectId String
    name           String
    purpose        String?
    quantity       Int                @default(1)
    unitCostUsd    Float              @default(0)
    vendor         String?
    link           String?
    sortOrder      Int                @default(0)
    createdAt      TimestampString(3) @default(now())
    updatedAt      TimestampString(3) @onCreate(now()) @onUpdate(now())
    themeProject   ThemeProject       @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "bom_item_themeProjectId_sortOrder_idx")

    @@index([themeProjectId, sortOrder], map: "bom_item_themeProjectId_sortOrder_idx")
    @@map("bom_item")
  }

  model Post {
    id              String              @id @onCreate(cuid(2))
    userId          String
    themeProjectId  String?
    kind            pg.enum(PostKind)   @default("FREEFORM")
    caption         String
    checkpointKey   String?
    objectKey       String
    thumbnailKey    String?
    contentType     String?
    byteSize        Int?
    durationSeconds Int?
    width           Int?
    height          Int?
    status          pg.enum(PostStatus) @default("PROCESSING")
    publishedAt     TimestampString(3)?
    viewCount       Int                 @default(0)
    likeCount       Int                 @default(0)
    commentCount    Int                 @default(0)
    pinnedAt        TimestampString(3)?
    hiddenAt        TimestampString(3)?
    hiddenById      String?
    hiddenReason    String?
    weekNumber      Int?
    createdAt       TimestampString(3)  @default(now())
    updatedAt       TimestampString(3)  @onCreate(now()) @onUpdate(now())
    deletedAt       TimestampString(3)?
    comments        PostComment[]
    likes           PostLike[]
    publicReels     PublicReel[]
    reports         ContentReport[]
    views           PostView[]
    user            User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "post_userId_checkpointKey_idx")
    themeProject    ThemeProject?       @relation(fields: [themeProjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    @@index([status, publishedAt], map: "post_status_publishedAt_idx")
    @@index([themeProjectId, kind], map: "post_themeProjectId_kind_idx")
    @@index([userId, checkpointKey], map: "post_userId_checkpointKey_idx")
    @@index([userId, createdAt], map: "post_userId_createdAt_idx")
    @@index([themeProjectId], map: "post_themeProjectId_idx")
    @@map("post")
  }

  model PostComment {
    id           String              @id @onCreate(cuid(2))
    postId       String
    userId       String
    body         String
    hiddenAt     TimestampString(3)?
    hiddenById   String?
    hiddenReason String?
    createdAt    TimestampString(3)  @default(now())
    updatedAt    TimestampString(3)  @onCreate(now()) @onUpdate(now())
    deletedAt    TimestampString(3)?
    reports      ContentReport[]
    post         Post                @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "post_comment_postId_createdAt_idx")
    user         User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([postId, createdAt], map: "post_comment_postId_createdAt_idx")
    @@index([userId], map: "post_comment_userId_idx")
    @@map("post_comment")
  }

  model WorkSession {
    id             String               @id @onCreate(cuid(2))
    themeProjectId String
    phase          pg.enum(Phase)
    title          String
    content        String?
    hoursClaimed   Float
    hoursApproved  Float?
    hoursSource    pg.enum(HoursSource) @default("MANUAL")
    effectiveDate  String?
    weekNumber     Int?
    reviewComments String?
    reviewedAt     TimestampString(3)?
    reviewedById   String?
    createdAt      TimestampString(3)   @default(now())
    updatedAt      TimestampString(3)   @onCreate(now()) @onUpdate(now())
    deletedAt      TimestampString(3)?
    media          SessionMedia[]
    reports        ContentReport[]
    timelapses     SessionTimelapse[]
    themeProject   ThemeProject         @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "work_session_themeProjectId_phase_idx")

    @@index([themeProjectId, phase], map: "work_session_themeProjectId_phase_idx")
    @@index([themeProjectId, createdAt], map: "work_session_themeProjectId_createdAt_idx")
    @@index([effectiveDate], map: "work_session_effectiveDate_idx")
    @@map("work_session")
  }

  model ContentReport {
    id             String                @id @onCreate(cuid(2))
    reporterId     String
    target         pg.enum(ReportTarget)
    reason         pg.enum(ReportReason)
    details        String?
    postId         String?
    commentId      String?
    themeProjectId String?
    targetUserId   String?
    workSessionId  String?
    status         pg.enum(ReportStatus) @default("OPEN")
    resolvedAt     TimestampString(3)?
    resolvedById   String?
    createdAt      TimestampString(3)    @default(now())
    updatedAt      TimestampString(3)    @onCreate(now()) @onUpdate(now())
    reporter       User                  @relation(name: "ContentReport_reporter", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    post           Post?                 @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    comment        PostComment?          @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    themeProject   ThemeProject?         @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    targetUser     User?                 @relation(name: "ContentReport_targetUser", fields: [targetUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    workSession    WorkSession?          @relation(fields: [workSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([reporterId, postId], map: "content_report_open_post_idx", unique: true, where: sql`((status = 'OPEN'::"ReportStatus") AND ("postId" IS NOT NULL))`)
    @@index([reporterId, commentId], map: "content_report_open_comment_idx", unique: true, where: sql`((status = 'OPEN'::"ReportStatus") AND ("commentId" IS NOT NULL))`)
    @@index([reporterId, themeProjectId], map: "content_report_open_project_idx", unique: true, where: sql`((status = 'OPEN'::"ReportStatus") AND ("themeProjectId" IS NOT NULL))`)
    @@index([reporterId, targetUserId], map: "content_report_open_user_idx", unique: true, where: sql`((status = 'OPEN'::"ReportStatus") AND ("targetUserId" IS NOT NULL))`)
    @@index([reporterId, workSessionId], map: "content_report_open_session_idx", unique: true, where: sql`((status = 'OPEN'::"ReportStatus") AND ("workSessionId" IS NOT NULL))`)
    @@index([status, createdAt], map: "content_report_status_createdAt_idx")
    @@index([reporterId], map: "content_report_reporterId_idx")
    @@map("content_report")
  }

  model HackatimeLink {
    id               String              @id @onCreate(cuid(2))
    themeProjectId   String
    hackatimeProject String
    phase            pg.enum(Phase)      @default("BUILD")
    hoursApproved    Float?
    reviewedAt       TimestampString(3)?
    reviewedById     String?
    cachedSeconds    Int?
    cachedAt         TimestampString(3)?
    lastFetchError   String?
    cachedSpans      Jsonb?
    spansFetchedAt   TimestampString(3)?
    spansFetchError  String?
    createdAt        TimestampString(3)  @default(now())
    themeProject     ThemeProject        @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "hackatime_link_themeProjectId_hackatimeProject_key")

    @@index([themeProjectId, hackatimeProject], map: "hackatime_link_themeProjectId_hackatimeProject_key", unique: true)
    @@index([themeProjectId, phase], map: "hackatime_link_themeProjectId_phase_idx")
    @@index([cachedAt], map: "hackatime_link_cachedAt_idx", where: sql`("hoursApproved" IS NULL)`)
    @@map("hackatime_link")
  }

  model HcbGrantTopUp {
    id             String              @id @onCreate(cuid(2))
    userId         String
    themeProjectId String
    phase          pg.enum(Phase)
    grantHashid    String
    amountCents    Int
    transactionId  String?
    sentAt         TimestampString(3)?
    error          String?
    createdAt      TimestampString(3)  @default(now())
    createdById    String?
    user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "hcb_grant_topup_userId_themeProjectId_phase_key")
    themeProject   ThemeProject        @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([userId, themeProjectId, phase], map: "hcb_grant_topup_userId_themeProjectId_phase_key", unique: true)
    @@index([grantHashid], map: "hcb_grant_topup_grantHashid_key", unique: true)
    @@map("hcb_grant_topup")
  }

  model HelpTicket {
    id            String              @id @onCreate(cuid(2))
    authorSlackId String
    helpChannel   String
    helpTs        String
    createdAt     TimestampString(3)  @default(now())
    resolvedAt    TimestampString(3)?
    resolvedBy    String?

    @@index([helpChannel, helpTs], map: "help_ticket_helpChannel_helpTs_key", unique: true)
    @@index([authorSlackId, createdAt], map: "help_ticket_authorSlackId_createdAt_idx")
    @@index([resolvedAt], map: "help_ticket_resolvedAt_idx")
    @@map("help_ticket")
  }

  model ShopItem {
    id                       String                    @id
    name                     String
    description              String
    imageUrl                 String?
    category                 pg.enum(ShopItemCategory) @default("PRINTER_UPGRADE")
    priceCredits             Int
    costUsd                  Float?
    maxPerUser               Int                       @default(1)
    stock                    Int?
    requiresPrinterQualified Boolean                   @default(true)
    active                   Boolean                   @default(true)
    sortOrder                Int                       @default(0)
    createdAt                TimestampString(3)        @default(now())
    updatedAt                TimestampString(3)        @onCreate(now()) @onUpdate(now())
    orders                   ShopOrder[]
    regionPrices             ShopItemRegionPrice[]

    @@index([active, sortOrder], map: "shop_item_active_sortOrder_idx")
    @@map("shop_item")
  }

  model ShopOrder {
    id                   String                          @id @onCreate(cuid(2))
    orderNumber          Int                             @default(autoincrement())
    userId               String
    shopItemId           String
    quantity             Int
    unitCredits          Int
    totalCredits         Int
    itemNameSnapshot     String
    unitCostUsd          Float?
    stockDebited         Boolean?
    status               pg.enum(ShopOrderStatus)        @default("PENDING")
    holdReason           String?
    rejectionReason      String?
    encryptedAddress     String                          @default("")
    encryptedPhone       String                          @default("")
    trackingNumber       String?
    trackingCarrier      String?
    fulfillmentMethod    pg.enum(ShopFulfillmentMethod)?
    fulfillmentStage     pg.enum(ShopFulfillmentStage)   @default("UNFULFILLED")
    fulfillmentUpdatedAt TimestampString(3)?
    placedAt             TimestampString(3)              @default(now())
    heldAt               TimestampString(3)?
    rejectedAt           TimestampString(3)?
    fulfilledAt          TimestampString(3)?
    lastActorId          String?
    idempotencyKey       String?
    ledgerEntries        LedgerEntry[]
    notes                ShopOrderNote[]
    user                 User                            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    shopItem             ShopItem                        @relation(fields: [shopItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@index([userId, idempotencyKey], map: "shop_order_userId_idempotencyKey_key", unique: true)
    @@index([orderNumber], map: "shop_order_orderNumber_key", unique: true)
    @@index([userId], map: "shop_order_userId_idx")
    @@index([status, placedAt], map: "shop_order_status_placedAt_idx")
    @@index([shopItemId], map: "shop_order_shopItemId_idx")
    @@map("shop_order")
  }

  model LedgerEntry {
    id             String              @id @onCreate(cuid(2))
    userId         String
    themeProjectId String?
    kind           pg.enum(LedgerKind)
    bucket         pg.enum(CoinBucket) @default("SPENDABLE")
    amount         Int
    note           String?
    balanceBefore  Int
    balanceAfter   Int
    shopOrderId    String?
    createdById    String?
    createdAt      TimestampString(3)  @default(now())
    user           User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ledger_entry_userId_createdAt_idx")
    themeProject   ThemeProject?       @relation(fields: [themeProjectId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    shopOrder      ShopOrder?          @relation(fields: [shopOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: "ledger_entry_shopOrderId_kind_bucket_key")

    @@index([shopOrderId, kind, bucket], map: "ledger_entry_shopOrderId_kind_bucket_key", unique: true)
    @@index([userId, createdAt], map: "ledger_entry_userId_createdAt_idx")
    @@index([userId, themeProjectId, kind], map: "ledger_entry_userId_themeProjectId_kind_idx")
    @@index([userId, bucket], map: "ledger_entry_userId_bucket_idx")
    @@map("ledger_entry")
  }

  model PhaseSubmission {
    id                     String                 @id @onCreate(cuid(2))
    themeProjectId         String
    phase                  pg.enum(Phase)
    notes                  String?
    attachmentKeys         String?[]?             @default([])
    submittedInWeek        Int?
    scheduledWeek          Int?
    onTime                 Boolean                @default(false)
    partialFundingAccepted Boolean                @default(false)
    fundingDeclined        Boolean                @default(false)
    requestedBomUsd        Float?
    fundingCapUsd          Int?
    preReviewed            Boolean                @default(false)
    preReviewedAt          TimestampString(3)?
    ariSubmissionId        String?
    ariStatus              String?
    ariStatusAt            TimestampString(3)?
    ariDecision            String?
    ariSyncedAt            TimestampString(3)?
    ariShipError           String?
    resolvedAt             TimestampString(3)?
    resolvedResult         pg.enum(ReviewResult)?
    createdAt              TimestampString(3)     @default(now())
    claim                  ReviewClaim?
    dispute                ReviewDispute?
    reviews                SubmissionReview[]
    themeProject           ThemeProject           @relation(fields: [themeProjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([themeProjectId], map: "phase_submission_themeProjectId_idx")
    @@index([themeProjectId, phase, createdAt], map: "phase_submission_themeProjectId_phase_createdAt_idx")
    @@index([resolvedAt, createdAt], map: "phase_submission_resolvedAt_createdAt_idx")
    @@map("phase_submission")
  }

  model PostLike {
    id        String             @id @onCreate(cuid(2))
    postId    String
    userId    String
    createdAt TimestampString(3) @default(now())
    post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "post_like_postId_userId_key")
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([postId, userId], map: "post_like_postId_userId_key", unique: true)
    @@index([userId], map: "post_like_userId_idx")
    @@map("post_like")
  }

  model PostView {
    id        String             @id @onCreate(cuid(2))
    postId    String
    userId    String
    createdAt TimestampString(3) @default(now())
    post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "post_view_postId_userId_key")
    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([postId, userId], map: "post_view_postId_userId_key", unique: true)
    @@index([userId], map: "post_view_userId_idx")
    @@map("post_view")
  }

  model PrinterAward {
    id                 String                      @id @onCreate(cuid(2))
    userId             String
    qualifiedAt        TimestampString(3)
    qualifyingSnapshot Jsonb
    status             pg.enum(PrinterAwardStatus) @default("QUALIFIED")
    encryptedAddress   String                      @default("")
    encryptedPhone     String                      @default("")
    addressLockedAt    TimestampString(3)?
    trackingNumber     String?
    trackingCarrier    String?
    shippedAt          TimestampString(3)?
    deliveredAt        TimestampString(3)?
    revokedAt          TimestampString(3)?
    revokedReason      String?
    createdAt          TimestampString(3)          @default(now())
    updatedAt          TimestampString(3)          @onCreate(now()) @onUpdate(now())
    user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([userId], map: "printer_award_userId_key", unique: true)
    @@index([status], map: "printer_award_status_idx")
    @@map("printer_award")
  }

  model ProgramEvent {
    id          String               @id @onCreate(cuid(2))
    title       String
    colour      pg.enum(EventColour) @default("SLATE")
    description String?
    startsAt    TimestampString(3)
    endsAt      TimestampString(3)?
    published   Boolean              @default(true)
    seriesId    String?
    createdAt   TimestampString(3)   @default(now())
    updatedAt   TimestampString(3)   @onCreate(now()) @onUpdate(now())
