# ─── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection string; Orchard supplies this in production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/halflife?schema=public"
# 32+ random bytes (`openssl rand -base64 32`). Rotating it invalidates every session
BETTER_AUTH_SECRET=
# Public origin; must exactly match the registered OAuth redirect base, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
# Same value, exposed to the browser for absolute links.
# Also the origin encoded into phone-handoff QR codes: behind an
# ingress the request's own host is internal, and a QR nobody's phone
# can reach is a QR that silently never works.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Hack Club Auth (identity, Slack ID, YSWS verification status) ────────────
# OAuth client id from auth.hackclub.com; request one per environment
HCA_CLIENT_ID=
# OAuth client secret
HCA_CLIENT_SECRET=
# OIDC discovery document
HCA_DISCOVERY_URL=https://auth.hackclub.com/.well-known/openid-configuration
# true also requests address+birthdate scopes; requires PII_ENCRYPTION_KEY
PULL_HCA_PII=false
# HKDF input for AES-256-GCM at-rest encryption. Losing it makes stored PII unrecoverable
PII_ENCRYPTION_KEY=

# ─── Hackatime (coding hours for firmware work) ───────────────────────────────
# OAuth client id for linking a Hackatime identity
HACKATIME_CLIENT_ID=
# OAuth client secret
HACKATIME_CLIENT_SECRET=
# Base URL of the Hackatime API
HACKATIME_API_BASE=https://hackatime.hackclub.com

# Lapse — every timelapse is recorded there. Register an OAuth app at Lapse
# with redirect URI https://<host>/api/auth/callback/lapse and the scopes
# user:read timelapse:read.
LAPSE_CLIENT_ID=
LAPSE_CLIENT_SECRET=
LAPSE_API_BASE=https://api.lapse.hackclub.com/api

# Repo checks before a week can be submitted (lib/repo-checks). Set ONE of:
# GH_PROXY_API_KEY for Hack Club's gh-proxy (what Stasis uses), or GITHUB_TOKEN
# (a fine-grained token with public repo read) for the GitHub API. With neither,
# the GitHub API is called unauthenticated: fine locally, 60 requests an hour.
GH_PROXY_API_KEY=
GITHUB_TOKEN=

# ─── Uploads (Cloudflare R2, S3-compatible) ──────────────────────────────────
# R2 access key id
S3_ACCESS_KEY_ID=
# R2 secret access key
S3_SECRET_ACCESS_KEY=
# Bucket holding journal images and timelapses
S3_BUCKET_NAME=
# https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public base that objects are served from, INCLUDING any path prefix. A custom
# domain fronting the whole account serves each bucket under its own path, so
# the base is https://assets.example.com/<bucket-name> rather than the bare
# host — get this wrong and uploads succeed while every reel 404s on playback.
# `pnpm verify:uploads` checks the whole round trip and will tell you.
S3_PUBLIC_URL=
# Hostname part of S3_PUBLIC_URL; next/image refuses hosts not listed in next.config.ts
NEXT_PUBLIC_UPLOAD_HOST=
# Per-file upload ceiling in bytes (default 100 MiB)
UPLOAD_MAX_BYTES=104857600

# ─── Airtable (RSVP funnel + the YSWS grant sink) ────────────────────────────
# Every Airtable write no-ops with a warning when these are unset, so local dev
# works with no Airtable at all.
# Personal access token with data.records:read/write on the base below
AIRTABLE_API_KEY=
# Half-Life base id (appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=
# Table id of "YSWS Project Submission" (tblXXXXXXXXXXXXXX)
AIRTABLE_YSWS_TABLE_ID=
# Table id of "RSVPs"
AIRTABLE_RSVP_TABLE_ID=
# Hack Club unified YSWS base; used to remove rows on un-approval
AIRTABLE_UNIFIED_BASE_ID=app3A5kJwYqxMLOgh
# "Approved Projects" table in the unified base
AIRTABLE_UNIFIED_APPROVED_TABLE=tblzWWGUYHVH7Zyqf

# ─── Slack (profile enrichment, review notifications) ────────────────────────
# Create the app from slack-app-manifest.yml at the repo root, then:
#   Bot User OAuth Token (xoxb-…)          → SLACK_BOT_TOKEN
#   Basic Information → Signing Secret      → SLACK_SIGNING_SECRET
# The two are independent: a token on its own leaves /api/slack/* rejecting
# every delivery 401, because both routes verify the HMAC signature first.
# xoxb- token; unset disables the outbound calls that need it (profile lookups,
# message posts, invites). The event routes fail closed on the secret instead.
SLACK_BOT_TOKEN=
# Signing secret. Without it the Slack routes 401 every request, silently.
SLACK_SIGNING_SECRET=
# The four channels the auto-invite and ticket relay act on. IDs are at the
# bottom of a channel's details pane; names will not work. The bot must already
# be a member of all of them — conversations.invite requires membership of the
# target, and member_joined_channel only fires for channels the bot is in.
# Anyone joining this channel is added to BULLETIN and HELP
SLACK_MAIN_CHANNEL_ID=
SLACK_BULLETIN_CHANNEL_ID=
SLACK_HELP_CHANNEL_ID=
# Private channel that new/resolved help tickets get mirrored into
SLACK_TICKETS_CHANNEL_ID=
# Where a disputed review is announced. Unset: the dispute is still in the
# console and the audit log, just not pushed to Slack.
SLACK_REVIEW_CHANNEL_ID=

# ─── Email (review notifications) ────────────────────────────────────────────
# Transactional email telling a maker when their submission is decided. Both
# must be set or email no-ops (Slack DMs still go out). Resend's HTTP API is
# called directly; the sending address must be a verified domain on the account.
RESEND_API_KEY=
# e.g. "Half Life <halflife@yourdomain.org>"
EMAIL_FROM=

# ─── Profile pictures ────────────────────────────────────────────────────────
# A Slack user's picture is read through Cachet, which caches it behind a stable
# URL (Slack's own image URLs expire). Optional: defaults to Hack Club's Cachet.
# Point this at your own instance to self-host, or leave it unset.
CACHET_BASE_URL=https://cachet.dunkirk.sh

# ─── Ari (project review) ────────────────────────────────────────────────────
# Server-only. Create a program at ari.hackclub.com, then copy its three
# secrets in. Without them this integration no-ops and reviews stay local.
# Program id from the Ari program settings
ARI_PROGRAM_ID=
# Signs requests Half Life sends to Ari (ships.create / withdraw / status)
ARI_SIGNING_SECRET=
# A DIFFERENT secret, for verifying inbound webhooks. Without it the webhook
# route answers 503 rather than trusting an unverified body.
ARI_WEBHOOK_SECRET=
# Optional. Only for staging or local tests; defaults to
# https://webhooks.ari.hackclub.com
ARI_BASE_URL=

# ─── Machine-to-machine ──────────────────────────────────────────────────────
# Bearer token for /api/integrations/*; Orchard jobs present this
INTEGRATION_API_KEY=
# Narrower bearer accepted only by the read-only participant export
EXPORT_API_KEY=

# ─── Program defaults (seed values for the ProgramSettings row) ──────────────
# After the first migration these live in the database and are edited from
# /admin/program. The env vars are only read when seeding a fresh database.
# ISO date of week 1, day 1. All week math derives from this
PROGRAM_START_DATE=2026-09-07
# IANA zone used for week boundaries and journal effective dates
PROGRAM_TIMEZONE=America/New_York

# ─── Access control ──────────────────────────────────────────────────────────
# Comma-separated emails auto-granted ADMIN on first sign-in; keep this to one or two people
SUPERADMIN_EMAILS=
# true puts HTTP basic auth in front of the whole site (pre-launch / staging)
REQUIRE_BASICAUTH=false
# Only read when REQUIRE_BASICAUTH=true
BASICAUTH_USERNAME=
# Only read when REQUIRE_BASICAUTH=true
BASICAUTH_PASSWORD=
# true writes by Airtable field id (survives column renames). Run `yarn dump-airtable-schema` and fill lib/airtable/schema.ts first
AIRTABLE_USE_FIELD_IDS=false
# true lets unverified accounts submit. Development only
SKIP_YSWS_VERIFICATION_CHECK=false
