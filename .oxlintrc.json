{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"nursery": "off",
		"pedantic": "warn",
		"perf": "warn",
		"restriction": "off",
		"style": "warn",
		"suspicious": "warn"
	},
	"env": {
		"browser": true,
		"builtin": true,
		"node": true
	},
	"ignorePatterns": [".next/**", "node_modules/**", "public/**", "src/app/generated/**"],
	"options": {
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "warn"
	},
	"plugins": ["eslint", "import", "jsx-a11y", "nextjs", "node", "oxc", "promise", "react", "typescript", "unicorn"],
	"rules": {
		"eslint/capitalized-comments": "off",
		"eslint/curly": "off",
		"eslint/eqeqeq": ["error", "smart"],
		"eslint/func-style": "off",
		"eslint/id-length": "off",
		"eslint/init-declarations": "off",
		"eslint/max-depth": "off",
		"eslint/max-lines": "off",
		"eslint/max-lines-per-function": "off",
		"eslint/max-params": "off",
		"eslint/max-statements": "off",
		"eslint/new-cap": "off",
		"eslint/no-await-in-loop": "off",
		"eslint/no-continue": "off",
		"eslint/no-else-return": "error",
		"eslint/no-implicit-coercion": "off",
		"eslint/no-inline-comments": "off",
		"eslint/no-lone-blocks": "off",
		"eslint/no-loop-func": "off",
		"eslint/no-magic-numbers": "off",
		"eslint/no-negated-condition": "off",
		"eslint/no-nested-ternary": "off",
		"eslint/no-new": "off",
		"eslint/no-promise-executor-return": "off",
		"eslint/no-shadow": "off",
		"eslint/no-template-curly-in-string": "off",
		"eslint/no-ternary": "off",
		"eslint/no-underscore-dangle": "off",
		"eslint/no-useless-concat": "warn",
		"eslint/no-useless-return": "warn",
		"eslint/no-var": "error",
		"eslint/object-shorthand": "warn",
		"eslint/one-var": "off",
		"eslint/prefer-const": "error",
		"eslint/prefer-destructuring": "off",
		"eslint/prefer-named-capture-group": "off",
		"eslint/prefer-object-spread": "off",
		"eslint/prefer-template": "warn",
		"eslint/require-await": "off",
		"eslint/require-unicode-regexp": "off",
		"eslint/sort-imports": "off",
		"eslint/sort-keys": "off",
		"import/consistent-type-specifier-style": "off",
		"import/exports-last": "off",
		"import/group-exports": "off",
		"import/max-dependencies": "off",
		"import/no-duplicates": "error",
		"import/no-named-as-default-member": "off",
		"import/no-named-export": "off",
		"import/no-nodejs-modules": "off",
		"import/no-unassigned-import": "off",
		"import/prefer-default-export": "off",
		"jsx-a11y/control-has-associated-label": "off",
		"jsx-a11y/interactive-supports-focus": "off",
		"jsx-a11y/media-has-caption": "off",
		"jsx-a11y/no-noninteractive-element-interactions": "off",
		"jsx-a11y/no-noninteractive-tabindex": "off",
		"jsx-a11y/prefer-tag-over-role": "off",
		"nextjs/no-html-link-for-pages": "off",
		"nextjs/no-img-element": "off",
		"node/callback-return": "off",
		"node/no-sync": "off",
		"oxc/branches-sharing-code": "off",
		"oxc/no-accumulating-spread": "off",
		"promise/always-return": "off",
		"promise/avoid-new": "off",
		"promise/no-nesting": "off",
		"promise/prefer-await-to-callbacks": "off",
		"promise/prefer-await-to-then": "off",
		"react/exhaustive-deps": "off",
		"react/exhaustive-effect-dependencies": "off",
		"react/function-component-definition": "off",
		"react/hook-use-state": "off",
		"react/jsx-handler-names": "off",
		"react/jsx-max-depth": "off",
		"react/jsx-no-constructed-context-values": "off",
		"react/jsx-no-target-blank": "warn",
		"react/jsx-no-useless-fragment": "warn",
		"react/jsx-props-no-spreading": "off",
		"react/memo-dependencies": "off",
		"react/no-array-index-key": "off",
		"react/no-object-type-as-default-prop": "off",
		"react/no-unescaped-entities": "warn",
		"react/purity": "off",
		"react/react-in-jsx-scope": "off",
		"react/refs": "off",
		"react/set-state-in-effect": "off",
		"typescript/consistent-indexed-object-style": "off",
		"typescript/consistent-type-definitions": "off",
		"typescript/consistent-type-imports": "warn",
		"typescript/method-signature-style": ["error", "method"],
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		"typescript/parameter-properties": ["error", { "prefer": "parameter-property" }],
		"typescript/prefer-includes": "warn",
		"typescript/prefer-nullish-coalescing": "warn",
		"typescript/prefer-ts-expect-error": "warn",
		"typescript/return-await": "warn",
		"unicorn/catch-error-name": "off",
		"unicorn/consistent-existence-index-check": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/custom-error-definition": "off",
		"unicorn/empty-brace-spaces": "off",
		"unicorn/explicit-length-check": "off",
		"unicorn/filename-case": "off",
		"unicorn/max-nested-calls": "off",
		"unicorn/no-array-callback-reference": "off",
		"unicorn/no-await-expression-member": "off",
		"unicorn/no-negated-condition": "off",
		"unicorn/no-nested-ternary": "off",
		"unicorn/no-null": "off",
		"unicorn/no-object-as-default-parameter": "off",
		"unicorn/no-useless-undefined": "off",
		"unicorn/number-literal-case": "off",
		"unicorn/numeric-separators-style": "off",
		"unicorn/prefer-add-event-listener": "off",
		"unicorn/prefer-code-point": "warn",
		"unicorn/prefer-date-now": "warn",
		"unicorn/prefer-dom-node-append": "off",
		"unicorn/prefer-global-this": "off",
		"unicorn/prefer-includes": "warn",
		"unicorn/prefer-logical-operator-over-ternary": "off",
		"unicorn/prefer-math-min-max": "off",
		"unicorn/prefer-native-coercion-functions": "off",
		"unicorn/prefer-number-coercion": "off",
		"unicorn/prefer-query-selector": "off",
		"unicorn/prefer-response-static-json": "off",
		"unicorn/prefer-set-has": "off",
		"unicorn/prefer-spread": "off",
		"unicorn/prefer-string-replace-all": "off",
		"unicorn/prefer-ternary": "off",
		"unicorn/prefer-top-level-await": "off",
		"unicorn/switch-case-braces": "off",
		"unicorn/text-encoding-identifier-case": "off"
	}
}
