node_modules
.next
out
coverage
# Any local scratch. `next build` with a `distDir` outside the project lands here (it joins the path onto the root), and a stray one is a ~1GB build context.
tmp
.git
.gitignore
Dockerfile*
.dockerignore
.github
.vscode
.idea
*.log
.DS_Store
.env*
!.env.example
# Credentials. .gitignore keeps every one of these out of the repository, so they
# have to be kept out of the build context too: the builder runs `COPY . .`, and a
# key file in the working tree would land in an image layer and in everything
# pushed from it.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
*.jks
*.keystore
# The local preview config holds a throwaway auth secret (see .gitignore).
.claude
# Local signup sink (data/signups.jsonl) holds real email addresses and has no
# business in a build context.
data
# The stasis import scripts carry their own .env with a source-database
# credential. Docker matches `.env*` against the context root, so the rule
# above does not reach `import/.env`.
import
# Generated at `pnpm db:generate`; kept out of the context so `COPY . .` in the
# builder cannot clobber the freshly generated client with a stale local one.
src/app/generated
docker-compose*.yaml
dev.sh
# Production installs and builds with Bun (see Dockerfile), so the pnpm
# lockfile and workspace config stay out of the build context. The files
# themselves remain in the repo: local dev and CI still use pnpm.
pnpm-lock.yaml
pnpm-workspace.yaml
docs
README.md
